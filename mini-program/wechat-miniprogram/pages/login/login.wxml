<view class="page login-page theme-{{currentTheme}}">
  <view class="login-content">
    <view class="brand-block">
      <view class="brand-mark ai-mark">幺</view>
      <view class="brand-name">饿了幺</view>
      <view class="brand-subtitle">用微信身份隔离你的约饭、推荐和规划数据</view>
    </view>

    <view class="login-copy">
      <view class="login-title">先登录一下</view>
      <view class="login-desc">
        登录后后端会为当前微信用户签发 sessionToken，后续多人约饭、单人推荐和周边轻规划都会绑定到同一个 userId。
      </view>
    </view>

    <view class="mvp-note">
      <view class="note-icon">i</view>
      <view class="note-text">AppSecret 只放在服务器环境变量里，小程序端不会保存 openid、session_key 或密钥。</view>
    </view>

    <view wx:if="{{errorMessage}}" class="login-error">{{errorMessage}}</view>

    <view class="login-actions">
      <button class="login-button" loading="{{isLoading}}" bindtap="handleLogin">
        微信授权登录
      </button>
      <view class="login-tip">登录即代表同意《用户协议》与《隐私政策》</view>
    </view>
  </view>
</view>
