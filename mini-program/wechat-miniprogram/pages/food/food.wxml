<view class="el-page food-page theme-{{currentTheme}}">
  <view class="el-bar food-bar">
    <view class="left food-back" bindtap="handleBackToHome">← 今天吃什么</view>
    <view class="right {{connectionStatus.statusClass}}" bindtap="handleConnectionStatusTap">
      <text class="el-dot header-online-dot"></text>
      <text>{{connectionStatus.text}}</text>
    </view>
  </view>

  <view wx:if="{{prefCheckActive}}" class="food-pref-check">
    <view class="el-section__head">
      <view class="el-section__no">PRE</view>
      <view class="el-section__title">先确认偏好</view>
      <view class="el-section__rule"></view>
    </view>
    <view class="el-hero el-hero--md">{{prefCheckSummary}}</view>
    <view wx:if="{{prefCheckDisclaimer}}" class="el-note pref-note">
      <text class="el-note__tag">NOTE</text>{{prefCheckDisclaimer}}
    </view>
    <view class="question-options">
      <view
        wx:for="{{prefCheckOptions}}"
        wx:key="action"
        class="question-option"
        data-action="{{item.action}}"
        data-label="{{item.label}}"
        bindtap="handlePrefCheckOptionTap"
      >
        <view class="question-option__no">{{index + 1}}</view>
        <view class="question-option__body">{{item.label}}</view>
        <view class="question-option__arrow">→</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!isFinished && currentQuestion}}" class="food-question">
    <view class="question-meta">
      <text>QUESTION {{session.questionIndex + 1}}{{session.totalQuestions ? ' / ' + session.totalQuestions : ''}}</text>
      <text wx:if="{{currentQuestion.optional}}">可跳过</text>
    </view>

    <view class="el-segs food-segs">
      <view class="el-segs__seg {{progressPercent >= 25 ? 'el-segs__seg--ink' : ''}}"></view>
      <view class="el-segs__seg {{progressPercent >= 50 ? 'el-segs__seg--ink' : ''}}"></view>
      <view class="el-segs__seg {{progressPercent >= 75 ? 'el-segs__seg--ink' : ''}}"></view>
      <view class="el-segs__seg {{progressPercent >= 100 ? 'el-segs__seg--ink' : ''}}"></view>
    </view>

    <view class="el-hero question-title">{{currentQuestion.title}}</view>

    <view wx:if="{{isTagQuestion}}" class="tag-question-groups">
      <view wx:for="{{tagGroups}}" wx:key="type" wx:for-item="group" class="tag-question-group">
        <view class="tag-group-title">{{group.title}}</view>
        <view class="tag-row">
          <view
            wx:for="{{group.tags}}"
            wx:for-item="tag"
            wx:key="id"
            class="tag-option {{tag.isSelected ? 'selected' : ''}}"
            data-id="{{tag.id}}"
            data-type="{{tag.type}}"
            data-mode="{{group.mode}}"
            bindtap="handleTagTap"
          >
            {{tag.label}}
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="question-options">
      <view
        wx:for="{{currentOptions}}"
        wx:key="value"
        class="question-option {{item.isSelected ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="handleOptionTap"
      >
        <view class="question-option__no">{{index + 1}}</view>
        <view class="question-option__body">{{item.value}}</view>
        <view class="question-option__check">{{item.isSelected ? '✓' : ''}}</view>
      </view>
    </view>

    <view class="slot-summary-card">
      <view class="slot-summary-bar" bindtap="toggleSlotSummary">
        <view>
          <view class="slot-summary-label">已收集</view>
          <view class="slot-summary-text">{{slotSummaryText}}</view>
        </view>
        <button class="slot-summary-toggle">{{showSlotSummaryDetail ? '收起' : '查看'}}</button>
      </view>

      <view wx:if="{{showSlotSummaryDetail}}" class="slots-panel">
        <view
          class="slot-row {{item.rowClass}}"
          wx:for="{{summaryFields}}"
          wx:key="questionId"
          data-question-id="{{item.questionId}}"
          data-available="{{item.isAvailable}}"
          bindtap="handleSummaryFieldTap"
        >
          <view class="slot-label">{{item.label}}</view>
          <view class="slot-value">{{item.value}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{isFinished}}" class="food-results">
    <view class="result-hero">
      <view class="result-kicker">{{slotSummaryText}}</view>
      <view class="el-hero el-hero--md">这几家今天<text class="line-break"></text>都能开伙。</view>
    </view>

    <view wx:if="{{recommendationNotice}}" class="el-note recommendation-notice">
      <text class="el-note__tag">NOTE</text>{{recommendationNotice}}
    </view>

    <view class="recommendation-list">
      <view class="shop-card {{index === 0 ? 'featured' : ''}}" wx:for="{{recommendations}}" wx:key="id">
        <view class="shop-head">
          <view class="shop-rank">{{index === 0 ? 'TOP' : index + 1}}</view>
          <view class="shop-title-wrap">
            <view class="shop-name">{{item.name}}</view>
            <view class="shop-type">{{item.type}}</view>
          </view>
        </view>

        <view class="el-stat-grid shop-stats">
          <view>
            <view class="el-stat__v">{{item.perCapita}}</view>
            <view class="el-stat__l">人均</view>
          </view>
          <view>
            <view class="el-stat__v">{{item.distance}}</view>
            <view class="el-stat__l">距离</view>
          </view>
          <view>
            <view class="el-stat__v">{{item.rating}}</view>
            <view class="el-stat__l">评分</view>
          </view>
          <view>
            <view class="el-stat__v">{{index === 0 ? '首推' : '备选'}}</view>
            <view class="el-stat__l">排序</view>
          </view>
        </view>

        <view class="matched-tags">
          <text wx:for="{{item.matchedTags}}" wx:for-item="tag" wx:key="*this" class="el-chip">{{tag}}</text>
          <text wx:if="{{!item.matchedTags.length}}" class="el-chip">稳妥选择</text>
        </view>

        <view class="shop-reason">{{item.reason}}</view>
        <view class="el-note shop-risk">
          <text class="el-note__tag">NOTE</text>{{item.riskTip}}
        </view>
      </view>
    </view>

    <view wx:if="{{showAdjustmentOptions}}" class="adjustment-panel">
      <view class="el-section__head">
        <view class="el-section__no">ADJ</view>
        <view class="el-section__title">调整方向</view>
        <view class="el-section__rule"></view>
      </view>
      <view class="tag-row">
        <view
          wx:for="{{adjustmentOptions}}"
          wx:key="action"
          class="tag-option"
          data-action="{{item.action}}"
          data-label="{{item.label}}"
          bindtap="handleAdjustmentOptionTap"
        >
          {{item.label}}
        </view>
      </view>
      <view class="adjustment-input-row">
        <input
          class="adjustment-input"
          value="{{adjustmentManualInput}}"
          placeholder="也可以直接说哪里不满意"
          placeholder-class="manual-placeholder"
          bindinput="handleAdjustmentManualInput"
        />
        <button class="adjustment-submit" bindtap="handleAdjustmentManualSubmit">发送</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!isFinished && currentQuestion}}" class="reply-dock">
    <button wx:if="{{session.questionIndex > 0}}" class="el-btn el-btn--ghost reply-back" bindtap="handleGoBack">上一题</button>
    <view class="input-bar">
      <input
        class="manual-input"
        value="{{manualAnswer}}"
        placeholder="也可以直接告诉我你的想法"
        placeholder-class="manual-placeholder"
        bindinput="handleManualInput"
      />
      <button class="el-btn el-btn--primary send-button" bindtap="handleConfirm">发送</button>
    </view>
  </view>

  <view wx:elif="{{isFinished}}" class="result-actions-wrap">
    <view wx:if="{{isFinished && !memoryDecision}}" class="memory-actions">
      <view class="memory-actions-hint">这次的偏好要不要长期记住？长期记忆完全由你决定。</view>
      <view class="memory-actions-row">
        <button class="el-btn el-btn--primary memory-keep-button" bindtap="handleSavePreference">记住偏好</button>
        <button class="el-btn el-btn--ghost memory-once-button" bindtap="handleSessionOnly">仅本次</button>
      </view>
    </view>

    <view wx:if="{{isFinished && memoryDecision}}" class="memory-decision-note">
      <text wx:if="{{memoryDecision === 'kept'}}">已加入长期偏好</text>
      <text wx:if="{{memoryDecision === 'session-only'}}">本次条件不会写入长期偏好</text>
    </view>

    <view class="result-actions">
      <button class="el-btn el-btn--ghost" bindtap="handleRefreshRecommendations">换一批</button>
      <button class="el-btn el-btn--ghost" bindtap="handleStartAdjustment">调整</button>
      <button class="el-btn el-btn--primary" bindtap="handleStartOver">重新开始</button>
    </view>
  </view>
</view>
