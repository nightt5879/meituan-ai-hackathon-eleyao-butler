/* ─── Lightweight entrance and press animations ─────────────────────────
   Scope: chat messages, quick reply chips, recommendation cards,
   refresh notice, and the send button.
   The custom header, online status block, input bar, and chat input are
   intentionally NOT animated to preserve current layout stability.
   Press feedback for chips and the send button uses background / border /
   box-shadow / opacity — never transform: scale — so Chinese text stays
   crisp in WeChat DevTools and on device. */

@keyframes messageFadeUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Opacity-only entrance for recommendation cards and the refresh notice.
   Translate-based entrance was removed because the transform animation,
   combined with animation-fill-mode: both, kept the elements on a
   compositor layer and softened the Chinese glyphs inside. */
@keyframes cardFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes noticeFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.chat-message {
  animation: messageFadeUp 320ms ease-out both;
}

/* No animation on chips — running an entrance animation forces the
   compositor to rasterise the chip, which can soften Chinese glyphs.
   Chips are styled statically; only the press state transitions. */
.quick-chip,
.tag-chip,
.adjustment-chip {
  transition: background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease, color 160ms ease;
}

/* Glass press feedback: surface becomes more opaque, border picks up a
   soft primary tint, shadow tightens. Transform explicitly nulled so
   no scale/translate can sneak in via inheritance or future edits. */
.quick-chip:active,
.tag-chip:active,
.adjustment-chip:active {
  background: rgba(255, 255, 255, 0.90);
  border-color: rgba(255, 138, 61, 0.42);
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08), inset 0 1rpx 0 rgba(255, 255, 255, 0.82);
  transform: none;
  animation: none;
}

/* Dark theme: dark frosted glass instead of bright white panels. */
.theme-night .quick-chip,
.theme-night .tag-chip,
.theme-night .adjustment-chip,
.theme-black-pink .quick-chip,
.theme-black-pink .tag-chip,
.theme-black-pink .adjustment-chip,
.theme-dark .quick-chip,
.theme-dark .tag-chip,
.theme-dark .adjustment-chip {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.16);
  color: var(--theme-chip-text, #F5F5F5);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}

.theme-night .header-back-button,
.theme-black-pink .header-back-button,
.theme-dark .header-back-button {
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.08);
  color: var(--theme-text, #F5F5F5);
}

.theme-night .quick-chip.selected,
.theme-night .tag-chip.selected,
.theme-black-pink .quick-chip.selected,
.theme-black-pink .tag-chip.selected,
.theme-dark .quick-chip.selected,
.theme-dark .tag-chip.selected {
  background: var(--theme-primary-ghost, rgba(255, 159, 67, 0.18));
  border-color: var(--theme-primary, #FF9F43);
  color: var(--theme-primary-deep, #FF9F43);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

.theme-night .quick-chip:active,
.theme-night .tag-chip:active,
.theme-night .adjustment-chip:active,
.theme-black-pink .quick-chip:active,
.theme-black-pink .tag-chip:active,
.theme-black-pink .adjustment-chip:active,
.theme-dark .quick-chip:active,
.theme-dark .tag-chip:active,
.theme-dark .adjustment-chip:active {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 159, 67, 0.44);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.24), inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
}

/* Opacity-only fade — no fill-mode: both — so no layer state is held
   after the animation completes. Text inside shop cards stays sharp. */
.shop-card {
  animation: cardFadeIn 220ms ease-out;
}

.recommendation-notice {
  animation: noticeFadeIn 220ms ease-out;
}

.send-button {
  transition: opacity 160ms ease, box-shadow 160ms ease;
}

/* Send button press feedback: opacity dip + softer shadow. No scale. */
.send-button:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.12);
}

/* ─── Result-page additions ─────────────────────────────────────────────
   Card section labels, slot-summary disclaimer, third result action,
   and the explicit memory-choice block. No transform anywhere. */

.shop-section-label {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-primary-deep, #FF8A3D);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  -webkit-font-smoothing: antialiased;
}

.matched-tags-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.matched-tags-row .matched-tags {
  margin-top: 0;
}

.slot-summary-hint {
  margin-top: 8rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 22rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.result-actions-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--theme-bg, #FFF8EF);
}

.result-actions-wrap .result-actions {
  padding: 0;
  background: transparent;
}

.tertiary-action-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  background: var(--theme-card, #FFFDF8);
  color: var(--theme-muted, #8A6A4F);
  font-size: 26rpx;
  line-height: 74rpx;
  transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  -webkit-font-smoothing: antialiased;
}

.tertiary-action-button::after {
  border: 0;
}

.tertiary-action-button:active {
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-text, #3A2A1A);
}

.memory-actions {
  padding: 20rpx 22rpx 22rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-radius: 22rpx;
  background: var(--theme-card, #FFFDF8);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
}

.memory-actions-hint {
  margin-bottom: 14rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.memory-actions-row {
  display: flex;
  gap: 14rpx;
}

.memory-keep-button,
.memory-once-button {
  flex: 1;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  line-height: 70rpx;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
  -webkit-font-smoothing: antialiased;
}

.memory-keep-button::after,
.memory-once-button::after {
  border: 0;
}

.memory-keep-button {
  background: var(--theme-primary, #FF8A3D);
  color: var(--theme-on-primary, #ffffff);
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 61, 0.20);
}

.memory-keep-button:active {
  opacity: 0.88;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 61, 0.16);
}

.memory-once-button {
  background: var(--theme-card, #FFFDF8);
  border: 1rpx solid var(--theme-border, #F3DDC7);
  color: var(--theme-muted, #8A6A4F);
}

.memory-once-button:active {
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-text, #3A2A1A);
}

.memory-decision-note {
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-primary-deep, #FF8A3D);
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
  -webkit-font-smoothing: antialiased;
}

/* Dark-theme variants for the new components */
.theme-night .shop-section-label,
.theme-black-pink .shop-section-label,
.theme-dark .shop-section-label {
  background: var(--theme-primary-ghost, rgba(255, 159, 67, 0.18));
  color: var(--theme-primary-deep, #FF9F43);
}

.theme-night .tertiary-action-button,
.theme-black-pink .tertiary-action-button,
.theme-dark .tertiary-action-button {
  border-color: rgba(255, 255, 255, 0.18);
  background: rgba(255, 255, 255, 0.06);
  color: var(--theme-muted, #B8B8B8);
}

.theme-night .tertiary-action-button:active,
.theme-black-pink .tertiary-action-button:active,
.theme-dark .tertiary-action-button:active {
  background: rgba(255, 255, 255, 0.12);
  color: var(--theme-text, #F5F5F5);
}

.theme-night .memory-actions,
.theme-black-pink .memory-actions,
.theme-dark .memory-actions {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.30);
}

.theme-night .memory-once-button,
.theme-black-pink .memory-once-button,
.theme-dark .memory-once-button {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.18);
  color: var(--theme-muted, #B8B8B8);
}

.theme-night .memory-once-button:active,
.theme-black-pink .memory-once-button:active,
.theme-dark .memory-once-button:active {
  background: rgba(255, 255, 255, 0.12);
  color: var(--theme-text, #F5F5F5);
}

.theme-night .memory-decision-note,
.theme-black-pink .memory-decision-note,
.theme-dark .memory-decision-note {
  background: var(--theme-primary-ghost, rgba(255, 159, 67, 0.16));
  color: var(--theme-primary-deep, #FF9F43);
}

/* ─── Preference pre-check ──────────────────────────────────────────────
   Chips inherit .quick-chip for glass style + crisp text (no transform).
   The disclaimer bubble is a smaller secondary bubble below the summary. */

.pref-check-message {
  margin-bottom: 4rpx;
}

.pref-check-chip {
  font-weight: 700;
}

.pref-check-disclaimer-bubble {
  margin-top: 8rpx;
  padding: 14rpx 18rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-muted, #8A6A4F);
  font-size: 22rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

.theme-night .pref-check-disclaimer-bubble,
.theme-black-pink .pref-check-disclaimer-bubble,
.theme-dark .pref-check-disclaimer-bubble {
  background: rgba(255, 255, 255, 0.06);
  color: var(--theme-muted, #B8B8B8);
}
