.food-page {
  min-height: 100vh;
  padding: 0;
  display: flex;
  flex-direction: column;
  background: var(--theme-bg, #FFF8EF);
}

.custom-food-header {
  position: sticky;
  top: 0;
  z-index: 2;
  box-sizing: border-box;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--theme-border, #F3DDC7);
  background: var(--theme-card, #FFFDF8);
}

.food-nav-row {
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
}

.header-back-hit {
  position: absolute;
  left: 0;
  top: 50%;
  z-index: 2;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  transform: translateY(-50%);
}

.header-back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 50%;
  background: var(--theme-card, rgba(255, 255, 255, 0.88));
  box-shadow: 0 8rpx 22rpx rgba(16, 24, 40, 0.08);
  color: var(--theme-text, #1F2937);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.food-nav-title {
  position: absolute;
  left: var(--nav-title-side, 48px);
  right: var(--nav-title-side, 48px);
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-text, #1F2937);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-online-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  max-width: 100%;
  margin-top: 4rpx;
  white-space: nowrap;
}

.header-online-status.status-connected .header-online-dot {
  background: #22C55E;
  box-shadow: 0 0 0 6rpx rgba(34, 197, 94, 0.12);
}

.header-online-status.status-backend-only .header-online-dot,
.header-online-status.status-checking .header-online-dot {
  background: #F59E0B;
  box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.14);
}

.header-online-status.status-error .header-online-dot,
.header-online-status.status-mock .header-online-dot {
  background: #EF4444;
  box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.12);
}

.header-online-status.status-degraded .header-online-dot {
  background: #F97316;
  box-shadow: 0 0 0 6rpx rgba(249, 115, 22, 0.14);
}

.header-online-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.header-online-text {
  color: var(--theme-muted, #64748B);
  font-size: 26rpx;
  line-height: 34rpx;
  white-space: nowrap;
}

.message-avatar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary, #FF8A3D);
  color: var(--theme-on-primary, #ffffff);
  font-weight: 700;
}

.chat-body {
  flex: 1;
  padding: 24rpx 24rpx 28rpx;
}

.progress-strip {
  margin-bottom: 20rpx;
  color: var(--theme-primary, #FF8A3D);
  font-size: 24rpx;
  font-weight: 700;
}

.progress-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--theme-bg-soft, #F5EFE4);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--theme-primary, #E8743A);
}

.optional-hint {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-muted, #8A6A4F);
  font-size: 22rpx;
}

.chat-thread {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  width: 100%;
  gap: 12rpx;
}

.message-content {
  display: flex;
  flex-direction: column;
  max-width: 590rpx;
}

.butler-content {
  align-items: flex-start;
}

.user-content {
  align-items: flex-end;
}

.butler-message {
  justify-content: flex-start;
}

.user-message {
  justify-content: flex-end;
}

.message-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-top: 2rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.chat-bubble {
  box-sizing: border-box;
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-all;
}

.butler-bubble {
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-top-left-radius: 6rpx;
  background: var(--theme-ai-bubble, #FFFFFF);
  color: var(--theme-text, #3A2A1A);
  box-shadow: 0 8rpx 22rpx rgba(255, 138, 61, 0.06);
}

.user-bubble {
  border-top-right-radius: 6rpx;
  background: var(--theme-user-bubble, #FFE3CC);
  color: var(--theme-user-text, #5C3517);
  font-weight: 600;
}

.reply-dock {
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--theme-border, #F3DDC7);
  background: var(--theme-card, #FFFDF8);
  box-shadow: 0 -12rpx 30rpx rgba(138, 106, 79, 0.08);
}

.reply-top-row {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.reply-title {
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  font-weight: 700;
}

.quick-groups {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tag-group-title {
  margin-bottom: 10rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 22rpx;
  font-weight: 700;
}

.inline-replies {
  max-width: 590rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-radius: 18rpx;
  background: var(--theme-card, #FFFDF8);
}

.quick-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-height: 280rpx;
  overflow-y: auto;
}

/* .tag-chip is applied alongside .quick-chip on tag-type inline chips.
   Both selectors share the same visual rules so .tag-chip works as a
   standalone alias if the two classes are ever used separately.
   Glassmorphism style with explicit rendering resets so Chinese glyphs
   stay sharp: no transform, no animation, no filter, no backdrop-filter,
   no text-shadow. Press feedback uses colour/shadow only. */
.quick-chip,
.tag-chip {
  box-sizing: border-box;
  min-height: 52rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: var(--theme-chip-text, #3A2A1A);
  font-size: 23rpx;
  line-height: 1.35;
  text-align: center;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.06), inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  transform: none;
  animation: none;
  filter: none;
  backdrop-filter: none;
  text-shadow: none;
  -webkit-font-smoothing: antialiased;
}

.quick-chip.selected,
.tag-chip.selected {
  border-color: var(--theme-primary, #FF8A3D);
  background: var(--theme-primary-soft, #FFF1E3);
  color: var(--theme-primary-deep, #FF8A3D);
  font-weight: 700;
  box-shadow: 0 8rpx 22rpx rgba(255, 138, 61, 0.14), inset 0 1rpx 0 rgba(255, 255, 255, 0.78);
  transform: none;
  animation: none;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
}

.manual-input {
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--theme-border, #F3DDC7);
  border-radius: 999rpx;
  background: var(--theme-bg, #FFF8EF);
  color: var(--theme-text, #3A2A1A);
  font-size: 27rpx;
}

.manual-placeholder {
  color: var(--theme-muted, #8A6A4F);
}

.chat-input {
  flex: 1;
  min-width: 0;
}

.send-button,
.back-button {
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.send-button {
  flex-shrink: 0;
  width: 128rpx;
