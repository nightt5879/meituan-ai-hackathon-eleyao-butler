.food-page {
  padding-top: 0;
  padding-bottom: 240rpx;
}

.food-bar {
  margin-bottom: var(--s-5);
}

.food-back {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-online-dot {
  background: var(--ok);
}

.status-backend-only .header-online-dot,
.status-checking .header-online-dot,
.status-degraded .header-online-dot {
  background: var(--warn);
}

.status-error .header-online-dot,
.status-mock .header-online-dot {
  background: var(--bad);
}

.food-pref-check,
.food-question,
.food-results {
  padding: 0 var(--page-x);
}

.pref-note {
  margin-top: var(--s-4);
}

.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-3);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
}

.food-segs {
  margin: var(--s-3) 0 var(--s-5);
}

.question-title {
  margin-bottom: var(--s-6);
}

.question-options {
  border-top: 1rpx solid var(--hair);
  border-bottom: 1rpx solid var(--hair);
}

.question-option {
  display: flex;
  align-items: center;
  gap: var(--s-3);
  min-height: var(--hit);
  padding: var(--s-3) var(--s-1);
  border-bottom: 1rpx solid var(--hair);
}

.question-option:last-child {
  border-bottom: 0;
}

.question-option.selected {
  margin-left: calc(var(--s-2) * -1);
  margin-right: calc(var(--s-2) * -1);
  padding-left: var(--s-3);
  padding-right: var(--s-3);
  background: var(--accent-soft);
}

.question-option__no {
  width: 44rpx;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-cap);
}

.question-option__body {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: var(--t-body-l);
  font-weight: 600;
  line-height: 1.35;
}

.question-option__check,
.question-option__arrow {
  flex-shrink: 0;
  width: 40rpx;
  color: var(--accent);
  font-size: 30rpx;
  text-align: right;
}

.tag-question-groups {
  display: flex;
  flex-direction: column;
  gap: var(--s-5);
}

.tag-group-title {
  margin-bottom: var(--s-3);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
}

.tag-option {
  box-sizing: border-box;
  min-height: 64rpx;
  padding: 13rpx 18rpx;
  border: 1rpx solid var(--hair);
  border-radius: var(--r-1);
  background: transparent;
  color: var(--ink-2);
  font-size: var(--t-cap);
  line-height: 1.35;
}

.tag-option.selected {
  border-color: transparent;
  background: var(--accent-soft);
  color: var(--accent-ink);
  font-weight: 600;
}

.slot-summary-card {
  margin-top: var(--s-6);
  border-top: 1rpx solid var(--hair);
  padding-top: var(--s-4);
}

.slot-summary-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--s-3);
}

.slot-summary-label {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-nano);
  letter-spacing: 1rpx;
}

.slot-summary-text {
  margin-top: 6rpx;
  color: var(--ink-2);
  font-size: var(--t-cap);
  line-height: 1.5;
}

.slot-summary-toggle {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--hair);
  background: var(--card);
  color: var(--ink);
  font-size: var(--t-cap);
  line-height: 54rpx;
}

.slots-panel {
  margin-top: var(--s-3);
  border-top: 1rpx solid var(--hair);
}

.slot-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--s-4);
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--hair);
}

.slot-row.disabled {
  opacity: 0.5;
}

.slot-label {
  flex-shrink: 0;
  color: var(--muted);
  font-size: var(--t-cap);
}

.slot-value {
  min-width: 0;
  color: var(--ink);
  font-size: var(--t-cap);
  font-weight: 600;
  text-align: right;
  word-break: break-all;
}

.reply-dock,
.result-actions-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: var(--s-3) var(--page-x) calc(var(--s-4) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hair-strong);
  background: var(--bg);
}

.reply-back {
  margin-bottom: var(--s-2);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.manual-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: var(--hit);
  padding: 0 20rpx;
  border: 1rpx solid var(--hair-strong);
  background: var(--card);
  color: var(--ink);
  font-size: var(--t-body);
}

.manual-placeholder {
  color: var(--muted);
}

.send-button {
  flex-shrink: 0;
  min-width: 112rpx;
  padding-left: 18rpx;
  padding-right: 18rpx;
}

.result-hero {
  margin-bottom: var(--s-5);
}

.result-kicker {
  margin-bottom: var(--s-2);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
  line-height: 1.4;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-3);
}

.result-source-chip {
  font-family: var(--font-mono);
  letter-spacing: 1rpx;
}

.line-break {
  display: block;
}

.recommendation-notice {
  margin-bottom: var(--s-4);
}

.recommendation-list {
  border-top: 1rpx solid var(--hair-strong);
}

.shop-card {
  padding: var(--s-5) 0;
  border-bottom: 1rpx solid var(--hair);
}

.shop-card.featured {
  margin-left: calc(var(--page-x) * -1);
  margin-right: calc(var(--page-x) * -1);
  padding-left: var(--page-x);
  padding-right: var(--page-x);
  background: var(--card);
}

.shop-head {
  display: flex;
  align-items: baseline;
  gap: var(--s-3);
}

.shop-rank {
  flex-shrink: 0;
  min-width: 54rpx;
  padding: 4rpx 10rpx;
  border: 1rpx solid var(--hair);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-nano);
  letter-spacing: 1rpx;
  text-align: center;
}

.featured .shop-rank {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--on-accent);
}

.shop-title-wrap {
  flex: 1;
  min-width: 0;
}

.shop-name {
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  line-height: 1.25;
}

.shop-type {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--t-cap);
}

.shop-stats {
  margin: var(--s-4) 0;
  gap: var(--s-2);
}

.matched-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-2);
  margin-bottom: var(--s-3);
}

.shop-reason {
  color: var(--ink-2);
  font-size: var(--t-body);
  line-height: 1.65;
}

.shop-risk {
  margin-top: var(--s-3);
}

.adjustment-panel {
  padding: var(--s-5) 0;
}

.adjustment-input-row {
  display: flex;
  align-items: center;
  gap: var(--s-2);
  margin-top: var(--s-3);
}

.adjustment-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 var(--s-3);
  border: 1rpx solid var(--hair-strong);
  background: var(--card);
  color: var(--ink);
  font-size: var(--t-cap);
}

.adjustment-submit {
  flex-shrink: 0;
  width: 104rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  background: var(--accent);
  color: var(--on-accent);
  font-size: var(--t-cap);
  line-height: 72rpx;
}

.memory-actions {
  margin-bottom: var(--s-3);
}

.memory-actions-hint,
.memory-decision-note {
  color: var(--muted);
  font-size: var(--t-cap);
  line-height: 1.5;
}

.memory-actions-row,
.result-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--s-2);
  margin-top: var(--s-2);
}

.memory-actions-row .el-btn,
.result-actions .el-btn {
  min-width: 0;
  padding-left: var(--s-2);
  padding-right: var(--s-2);
  font-size: var(--t-cap);
}
