<view class="page scaffold-page theme-{{currentTheme}}">
  <view class="page-bar">
    <button class="page-back" bindtap="handleBack">‹</button>
    <view class="page-heading">
      <view class="page-title">约饭任务看板</view>
      <view class="page-subtitle">共享成员偏好、冲突识别和推荐结果。</view>
    </view>
  </view>

  <view wx:if="{{board}}" class="panel-card progress-card">
    <view class="progress-head">
      <view>
        <view class="progress-title">{{board.task.title || '多人约饭'}}</view>
        <view class="progress-desc">{{board.submittedCount}} / {{board.expectedCount}} 已提交 · {{board.message}}</view>
      </view>
      <view class="progress-pill">{{board.status === 'remote_ok' ? '后端在线' : '本地兜底'}}</view>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{board.progressPercent}}%;"></view>
    </view>
    <view class="chip-row board-actions">
      <button class="secondary-button compact-button" bindtap="handleRefresh" loading="{{isLoading}}">刷新</button>
      <button class="primary-button compact-button" bindtap="handleGenerateRecommendation" loading="{{isRecommending}}">生成推荐</button>
    </view>
  </view>

  <view wx:if="{{board && board.members.length}}" class="board-section">
    <view class="section-head">
      <view class="section-dot"></view>
      <view>
        <view class="section-title-small">成员偏好</view>
        <view class="section-desc-small">来自同一个 taskId + inviteToken 的共享状态。</view>
      </view>
    </view>
    <view wx:for="{{board.members}}" wx:key="participantId" wx:for-item="member" class="panel-card member-card">
      <view class="member-head">
        <view class="member-name">{{member.nickname}}</view>
        <view class="progress-pill">{{member.manualFields.budgetMax ? member.manualFields.budgetMax + ' 元内' : '预算未填'}}</view>
      </view>
      <view class="member-desc">{{member.rawPreference}}</view>
      <view class="chip-row">
        <view wx:if="{{member.manualFields.spicyPreference}}" class="info-chip soft">{{member.manualFields.spicyPreference}}</view>
        <view wx:if="{{member.manualFields.leaveBefore}}" class="info-chip hard">{{member.manualFields.leaveBefore}} 前离开</view>
      </view>
    </view>
  </view>

  <view wx:if="{{board && !board.members.length}}" class="empty-panel section-empty">
    <view class="empty-title">还没有成员提交</view>
    <view class="empty-desc">把创建页返回的 fill 路径发给成员，提交后这里会刷新出共享偏好。</view>
  </view>

  <view wx:if="{{board && board.conflicts.length}}" class="board-section">
    <view class="section-head">
      <view class="section-dot"></view>
      <view>
        <view class="section-title-small">冲突识别</view>
        <view class="section-desc-small">预算、忌口、时间和聊天氛围会作为硬检查。</view>
      </view>
    </view>
    <view wx:for="{{board.conflicts}}" wx:key="description" wx:for-item="conflict" class="panel-card member-card">
      <view class="member-head">
        <view class="member-name">{{conflict.type}}</view>
        <view class="progress-pill">{{conflict.severity}}</view>
      </view>
      <view class="member-desc">{{conflict.description}}</view>
      <view class="member-desc muted">{{conflict.resolution_strategy}}</view>
    </view>
  </view>

  <view wx:if="{{board && board.recommendations.length}}" class="board-section">
    <view class="section-head">
      <view class="section-dot"></view>
      <view>
        <view class="section-title-small">候选方案</view>
        <view class="section-desc-small">已生成 2-3 个可执行候选，方便大家快速对比。</view>
      </view>
    </view>
    <view wx:for="{{board.recommendations}}" wx:key="restaurant_id" wx:for-item="candidate" class="panel-card candidate-card">
      <view class="member-head">
        <view class="member-name">{{candidate.name}}</view>
        <view class="progress-pill">{{candidate.category}}</view>
      </view>
      <view class="member-desc">人均 {{candidate.avg_price}} 元 · {{candidate.distance_m}} 米 · 评分 {{candidate.rating}}</view>
      <view class="chip-row">
        <view wx:for="{{candidate.tags}}" wx:key="*this" class="info-chip soft">{{item}}</view>
      </view>
      <view class="member-desc">{{candidate.reason}}</view>
      <view wx:if="{{candidate.audit}}" class="audit-box">自检：{{candidate.audit.llm_explanation}}</view>
    </view>
  </view>

  <view wx:if="{{board && board.finalChoice}}" class="panel-card board-section">
    <view class="section-title-small">首推：{{board.finalChoice.name}}</view>
    <view class="member-desc">{{board.finalChoice.reason}}</view>
    <view class="audit-box">{{board.groupMessage}}</view>
  </view>

  <button class="primary-button" bindtap="handleBackHome">回到首页</button>
</view>
