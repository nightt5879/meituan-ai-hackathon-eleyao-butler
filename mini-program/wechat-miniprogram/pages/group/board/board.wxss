@import "../group-common.wxss";

.board-page {
  padding-top: 0;
  padding-bottom: 140rpx;
}

.board-bar {
  margin-bottom: var(--s-5);
}

.board-hero {
  padding: 0 var(--page-x) var(--s-5);
}

.board-kicker {
  margin-bottom: var(--s-2);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
}

.board-message {
  margin-top: var(--s-3);
  color: var(--muted);
  font-size: var(--t-body);
  line-height: 1.55;
}

.board-progress {
  display: flex;
  align-items: baseline;
  gap: var(--s-2);
  margin-top: var(--s-5);
}

.board-progress__num {
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--t-bignum);
  font-weight: 600;
  line-height: 1;
}

.board-progress__meta {
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-body);
}

.board-progress__status {
  margin-left: auto;
  color: var(--warn);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
}

.progress-track {
  position: relative;
  height: 8rpx;
  margin-top: var(--s-2);
  background: repeating-linear-gradient(
    to right,
    var(--hair) 0,
    var(--hair) calc(20% - 4rpx),
    transparent calc(20% - 4rpx),
    transparent 20%
  );
}

.progress-fill {
  height: 100%;
  background: var(--accent);
}

.board-actions {
  display: flex;
  gap: var(--s-2);
  margin-top: var(--s-4);
}

.board-actions .el-btn {
  flex: 1;
}

.board-section {
  padding-bottom: var(--s-5);
}

.board-row {
  display: flex;
  align-items: baseline;
  gap: var(--s-3);
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--hair);
}

.board-row__no {
  width: 44rpx;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-cap);
}

.board-row__body {
  flex: 1;
  min-width: 0;
}

.board-row__title {
  color: var(--ink);
  font-size: var(--t-body-l);
  font-weight: 600;
}

.board-row__desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--t-cap);
  line-height: 1.5;
}

.board-row__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-1);
  margin-top: var(--s-2);
}

.board-row__value {
  flex-shrink: 0;
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--t-body);
  font-weight: 600;
}

.empty-panel {
  padding: var(--s-5) 0;
  border-top: 1rpx solid var(--hair);
  border-bottom: 1rpx solid var(--hair);
  border-left: 0;
  border-right: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.empty-title {
  color: var(--ink);
  font-size: var(--t-body-l);
  font-weight: 600;
}

.empty-desc {
  margin-top: var(--s-2);
  color: var(--muted);
  font-size: var(--t-cap);
  line-height: 1.55;
}

.conflict-row {
  display: flex;
  align-items: flex-start;
  gap: var(--s-3);
  padding: var(--s-3) 0;
  border-bottom: 1rpx solid var(--hair);
}

.conflict-row__tag {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-family: var(--font-mono);
  font-size: var(--t-nano);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.conflict-row__tag.hard {
  background: var(--bad-soft);
  color: var(--bad);
}

.conflict-row__body {
  flex: 1;
  min-width: 0;
}

.conflict-row__title {
  color: var(--ink);
  font-size: var(--t-body);
  font-weight: 600;
}

.conflict-row__desc,
.conflict-row__hint {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: var(--t-cap);
  line-height: 1.55;
}

.conflict-row__hint {
  color: var(--subtle);
}

.candidate-card {
  padding: var(--s-4) 0;
  border-top: 1rpx solid var(--hair);
}

.candidate-card.top {
  margin-left: calc(var(--page-x) * -1);
  margin-right: calc(var(--page-x) * -1);
  padding-left: var(--page-x);
  padding-right: var(--page-x);
  background: var(--card);
}

.candidate-head {
  display: flex;
  align-items: baseline;
  gap: var(--s-2);
}

.candidate-rank {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border: 1rpx solid var(--hair);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-nano);
  letter-spacing: 1rpx;
}

.top .candidate-rank {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--on-accent);
}

.candidate-title {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--t-h2);
  font-weight: 600;
  line-height: 1.25;
}

.candidate-price {
  color: var(--ink);
  font-family: var(--font-mono);
  font-size: var(--t-body-l);
  font-weight: 600;
}

.candidate-meta {
  margin-top: var(--s-2);
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  letter-spacing: 1rpx;
}

.candidate-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s-1);
  margin-top: var(--s-3);
}

.candidate-reason {
  margin-top: var(--s-3);
  color: var(--ink-2);
  font-size: var(--t-body);
  line-height: 1.65;
}

.candidate-note {
  margin-top: var(--s-3);
}

.board-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: var(--s-3) var(--page-x) calc(var(--s-4) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hair-strong);
  background: var(--bg);
}

.board-bottom .el-btn {
  width: 100%;
}
