@import "../group-common.wxss";

.progress-card {
  margin-bottom: 28rpx;
}

.progress-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.progress-title {
  color: var(--theme-text, #1F1A15);
  font-size: 30rpx;
  font-weight: 800;
}

.progress-desc {
  margin-top: 6rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 23rpx;
}

.progress-pill {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-ghost, #FFF4EA);
  color: var(--theme-primary-deep, #C75A22);
  font-size: 21rpx;
  font-weight: 800;
}

.progress-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--theme-bg-soft, #F5EFE4);
  overflow: hidden;
}

.progress-fill {
  width: 8%;
  height: 100%;
  border-radius: 999rpx;
  background: var(--theme-primary, #E8743A);
}

.avatar-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.empty-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border: 2rpx dashed var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 50%;
  background: var(--theme-bg-soft, #F5EFE4);
  color: var(--theme-subtle, #9A8F83);
  font-size: 22rpx;
  font-weight: 800;
}

.board-section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.section-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: var(--theme-primary, #E8743A);
}

.section-title-small {
  color: var(--theme-text, #1F1A15);
  font-size: 29rpx;
  font-weight: 800;
}

.section-desc-small {
  margin-top: 4rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 23rpx;
  line-height: 1.45;
}

.section-empty {
  padding-top: 34rpx;
  padding-bottom: 34rpx;
}

.board-actions {
  margin-top: 22rpx;
}

.compact-button {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 72rpx;
}

.secondary-button {
  margin: 0;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-muted, #6B6157);
  font-weight: 800;
}

.member-card,
.candidate-card {
  margin-bottom: 18rpx;
}

.member-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.member-name {
  min-width: 0;
  color: var(--theme-text, #1F1A15);
  font-size: 29rpx;
  font-weight: 800;
}

.member-desc {
  margin-top: 8rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.55;
}

.member-desc.muted {
  color: var(--theme-subtle, #9A8F83);
}

.audit-box {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: var(--theme-primary-ghost, #FFF4EA);
  color: var(--theme-primary-deep, #C75A22);
  font-size: 23rpx;
  line-height: 1.55;
}
