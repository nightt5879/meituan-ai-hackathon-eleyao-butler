<view class="page scaffold-page fill-scaffold theme-{{currentTheme}}">
  <view class="group-safe-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="group-safe-nav" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px; --nav-title-side: {{navTitleSidePadding}}px;">
      <view class="group-nav-back-hit" hover-class="group-nav-back-active" bindtap="handleBack" aria-label="返回">
        <view class="group-nav-back-button">
          <text class="group-nav-back-icon">‹</text>
        </view>
      </view>
      <view class="group-safe-title">填写偏好</view>
    </view>
    <view class="group-safe-subtitle">点几个标签就行；不写也能交，管家会兜底。</view>
  </view>

  <view wx:if="{{errorMessage}}" class="panel-card">
    <view class="field-label">无法加载任务</view>
    <view class="field-hint">{{errorMessage}}</view>
  </view>

  <view wx:elif="{{isLoadingTask && !taskSummary}}" class="task-brief">
    <view class="task-eyebrow">加载任务中…</view>
    <view class="task-title">正在通过 adapter.getTaskBoard 取数据</view>
  </view>

  <view wx:elif="{{taskSummary}}" class="task-brief">
    <view class="task-eyebrow">{{taskSummary.creatorName || '发起人'}} 邀请你 · 多人约饭</view>
    <view class="task-title">{{taskSummary.title}}</view>
    <view class="task-desc">{{taskSummary.summary}}</view>
    <view class="task-meta">
      <text wx:if="{{taskSummary.expectedPeopleCount}}">{{taskSummary.expectedPeopleCount}} 人</text>
      <text wx:if="{{taskSummary.expectedPeopleCount}}">{{taskSummary.submittedCount}}/{{taskSummary.expectedPeopleCount}} 已提交</text>
      <text wx:else>{{taskSummary.submittedCount}} 人已提交</text>
      <text wx:if="{{taskSummary.dinnerTime && taskSummary.dinnerTime !== '待商量'}}">{{taskSummary.dinnerTime}}</text>
      <text wx:if="{{taskSummary.locationText && taskSummary.locationText !== '待商量'}}">{{taskSummary.locationText}}</text>
    </view>
  </view>

  <view class="panel-card">
    <view class="field-label">用管家记忆一键填</view>
    <view class="field-hint">把你保存过的忌口/辣度/常用预算套到下面字段，提交前可以再改。</view>
    <button class="primary-button" bindtap="handleAutofillFromMemory">使用我的管家记忆</button>
  </view>

  <view class="panel-card">
    <view class="field">
      <view class="field-label">你的昵称</view>
      <input class="field-input" value="{{form.nickname}}" placeholder="例如：阿酒" placeholder-class="field-placeholder" data-field="nickname" bindinput="handleInput" />
    </view>
  </view>

  <view class="planner-card group-time-card">
    <view class="planner-card-title">⏰ 可参与时间</view>
    <view class="planner-card-desc">选择可参加的日期和大致时间段。</view>

    <view class="time-priority-grid">
      <view class="time-priority-item">
        <view class="field-label">日期优先级</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.days === item.value ? 'active' : ''}} {{item.value}}"
            data-field="days"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="time-priority-item">
        <view class="field-label">时间优先级</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.hours === item.value ? 'active' : ''}} {{item.value}}"
            data-field="hours"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="planner-field">
      <view class="planner-chip-list scroll-row">
        <view
          wx:for="{{dayChips}}"
          wx:key="value"
          class="planner-chip {{item.active ? 'selected' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleToggleDay"
        >{{item.value}}</view>
      </view>
    </view>

    <view class="planner-field">
      <view class="planner-chip-list">
        <view
          wx:for="{{timeModeOptions}}"
          wx:key="value"
          class="planner-chip {{form.timeMode === item.value ? 'selected' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleTimeModeTap"
        >{{item.label}}</view>
      </view>
    </view>

    <view wx:if="{{form.timeMode === 'specified'}}" class="planner-two-column planner-field">
      <picker class="planner-column" mode="time" value="{{form.startTime}}" bindchange="handleStartTimeChange">
        <view class="planner-picker-card">
          <view class="planner-picker-label">开始时间</view>
          <view class="planner-picker-value">{{form.startTime}}</view>
        </view>
      </picker>
      <picker class="planner-column" mode="time" value="{{form.endTime}}" bindchange="handleEndTimeChange">
        <view class="planner-picker-card">
          <view class="planner-picker-label">结束时间</view>
          <view class="planner-picker-value">{{form.endTime}}</view>
        </view>
      </picker>
    </view>

    <view wx:if="{{form.timeMode === 'allDay'}}" class="planner-note planner-field">
      当天时间都可以，管家会按大家的可参与日期合并。
    </view>

    <view class="field last custom-field-block">
      <view class="field-heading">
        <view class="field-label">时间补充（选填）</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.timeText === item.value ? 'active' : ''}} {{item.value}}"
            data-field="timeText"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <input
        class="field-input preference-custom-input"
        value="{{form.timeCustomText}}"
        placeholder="还有其他时间要求可以补充，例如周五晚一点也可以"
        placeholder-class="field-placeholder"
        data-field="timeCustomText"
        bindinput="handleInput"
      />
    </view>
  </view>

  <view class="panel-card">
    <view class="field last">
      <view class="field-heading">
        <view class="field-label">🚫 忌口 / 过敏</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.dietary === item.value ? 'active' : ''}} {{item.value}}"
            data-field="dietary"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field-hint">可多选；选「无忌口」会清空其他选择。</view>
      <view class="option-grid">
        <view
          wx:for="{{dietaryChips}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}} {{item.wide ? 'wide' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleToggleDietary"
        >{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field last">
      <view class="field-heading">
        <view class="field-label">🍽️ 想吃的品类</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.cuisine === item.value ? 'active' : ''}} {{item.value}}"
            data-field="cuisine"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="field-hint">可多选；选「都可以」会清空其他选择。</view>
      <view class="option-grid">
        <view
          wx:for="{{cuisineChips}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}} {{item.wide ? 'wide' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleToggleCuisine"
        >{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field last">
      <view class="field-heading">
        <view class="field-label">💰 预算</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.budget === item.value ? 'active' : ''}} {{item.value}}"
            data-field="budget"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="option-grid">
        <view
          wx:for="{{budgetChips}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}} {{item.wide ? 'wide' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleSelectBudget"
        >{{item.value}}</view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field last">
      <view class="field-heading">
        <view class="field-label">🌶️ 辣度</view>
        <view class="priority-toggle">
          <view
            wx:for="{{priorityOptions}}"
            wx:key="value"
            class="priority-option {{form.requirementPriority.spicy === item.value ? 'active' : ''}} {{item.value}}"
            data-field="spicy"
            data-value="{{item.value}}"
            bindtap="handleSelectPriority"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="option-grid">
        <view
          wx:for="{{spicyChips}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}} {{item.wide ? 'wide' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleSelectSpicy"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field last">
      <view class="field-label">👀 这条偏好谁能看</view>
      <view class="field-hint">选择这条偏好在多人约饭中的展示方式</view>
      <view class="privacy-option-list">
        <view
          wx:for="{{visibilityChips}}"
          wx:key="value"
          class="privacy-option {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleSelectVisibility"
        >
          <view class="privacy-copy">
            <view class="privacy-title">
              <text wx:if="{{item.value === 'public'}}">公开，大家都能看</text>
              <text wx:elif="{{item.value === 'nickname_only'}}">只显示昵称</text>
              <text wx:else>匿名，仅用于推荐</text>
            </view>
            <view class="privacy-desc">
              <text wx:if="{{item.value === 'public'}}">适合不敏感的共同偏好</text>
              <text wx:elif="{{item.value === 'nickname_only'}}">其他人只能看到你的昵称和选择</text>
              <text wx:else>不展示给其他成员，只参与推荐计算</text>
            </view>
          </view>
          <view class="privacy-check {{item.active ? 'checked' : ''}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field">
      <view class="field-label">📝 还有其他必须满足的吗？<text class="priority-tag must">必须满足</text></view>
      <view class="field-hint">用逗号或空格分隔。例如：要有素食、不在医院附近。</view>
      <textarea
        class="field-textarea"
        value="{{form.customHardRequirement}}"
        placeholder="例如：要有素食，必须能停车"
        placeholder-class="field-placeholder"
        data-field="customHardRequirement"
        bindinput="handleInput"
      ></textarea>
    </view>

    <view class="field">
      <view class="field-label">📝 还有其他希望的吗？<text class="priority-tag nice">希望有</text></view>
      <view class="field-hint">这些不一定满足，但管家会尽量考虑。</view>
      <textarea
        class="field-textarea"
        value="{{form.customSoftPreference}}"
        placeholder="例如：能拍照，靠窗座位"
        placeholder-class="field-placeholder"
        data-field="customSoftPreference"
        bindinput="handleInput"
      ></textarea>
    </view>

    <view class="field last">
      <view class="prompt-head">
        <view class="field-label prompt-title">快捷提示词</view>
        <view class="field-hint prompt-subtitle">点一下，自动拼到「希望有」里。</view>
      </view>
      <view class="prompt-chip-grid">
        <view
          wx:for="{{promptChips}}"
          wx:key="*this"
          class="prompt-chip-item"
          hover-class="prompt-chip-pressed"
          data-value="{{item}}"
          bindtap="handlePromptChipTap"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view class="panel-card">
    <view class="field-label">提交时会包含的需求</view>
    <view class="field-hint">必须满足（hardRequirements）</view>
    <view wx:if="{{previewHardRequirements.length}}" class="chip-row">
      <view wx:for="{{previewHardRequirements}}" wx:for-item="hr" wx:key="*this" class="info-chip hard">{{hr}}</view>
    </view>
    <view wx:else class="field-hint">— 当前没有必须满足项 —</view>

    <view class="field-hint" style="margin-top: 16rpx;">希望有（softPreferences）</view>
    <view wx:if="{{previewSoftPreferences.length}}" class="chip-row">
      <view wx:for="{{previewSoftPreferences}}" wx:for-item="sp" wx:key="*this" class="info-chip soft">{{sp}}</view>
    </view>
    <view wx:else class="field-hint">— 当前没有希望项 —</view>
  </view>

  <view class="empty-panel">
    <view class="empty-title">提交后会进入任务看板</view>
    <view class="empty-desc">提交会通过 adapter.submitPreference 写入本条偏好；同昵称重复提交会覆盖之前的内容。</view>
  </view>

  <button class="primary-button submit-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="handleSubmitPreference">提交我的偏好</button>
</view>
