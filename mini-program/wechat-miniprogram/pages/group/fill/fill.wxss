@import "../group-common.wxss";

.task-brief {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, var(--theme-primary, #E8743A), var(--theme-primary-deep, #C75A22));
  color: #FFFFFF;
  box-shadow: 0 18rpx 42rpx rgba(232, 116, 58, 0.18);
}

.task-eyebrow {
  margin-bottom: 12rpx;
  opacity: 0.86;
  font-size: 22rpx;
  font-weight: 700;
}

.task-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.38;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
  opacity: 0.9;
  font-size: 23rpx;
}

.option-grid {
  display: flex;
  gap: 10rpx;
}

.option-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 18rpx;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-text, #1F1A15);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.option-cell.active {
  border-color: var(--theme-primary, #E8743A);
  background: var(--theme-primary, #E8743A);
  color: var(--theme-on-primary, #FFFFFF);
}

.submit-button {
  margin-top: 24rpx;
}
