@import "../group-common.wxss";

.task-brief {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, var(--theme-primary, #5AD8B2), var(--theme-secondary, #BDF4E5));
  color: var(--theme-on-primary, #164E3F);
  box-shadow: var(--theme-shadow-button, 0 12rpx 30rpx rgba(90, 216, 178, 0.30));
}

.task-eyebrow {
  margin-bottom: 12rpx;
  opacity: 0.86;
  font-size: 22rpx;
  font-weight: 700;
}

.task-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.38;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
  opacity: 0.9;
  font-size: 23rpx;
}

.field-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.field-heading .field-label {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.priority-toggle {
  flex-shrink: 0;
  display: flex;
  padding: 4rpx;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 999rpx;
  background: var(--theme-bg-soft, #F5EFE4);
}

.priority-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
  white-space: nowrap;
}

.priority-option.active.must {
  background: var(--theme-soft, #DDF8EF);
  color: var(--theme-primary-deep, #164E3F);
}

.priority-option.active.nice {
  background: rgba(74, 144, 226, 0.14);
  color: #2B5A8F;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}

.option-cell {
  box-sizing: border-box;
  flex: 1 1 148rpx;
  min-width: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 999rpx;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-text, #1F1A15);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.option-cell.active {
  border-color: var(--theme-primary, #5AD8B2);
  background: var(--theme-primary, #5AD8B2);
  color: var(--theme-on-primary, #FFFFFF);
}

.hour-grid .option-cell {
  flex: 0 1 136rpx;
  min-width: 136rpx;
}

.submit-button {
  margin-top: 24rpx;
}

