<view class="page scaffold-page theme-{{currentTheme}}">
  <!-- Native navigation bar already provides the back arrow — no in-content
       page-back button here. Keep page-bar as a thin title container. -->
  <view class="page-bar create-page-bar">
    <view class="page-heading">
      <view class="page-title">发起约饭</view>
      <view class="page-subtitle">选一下人数就能生成任务链接，朋友点开就能填偏好。</view>
    </view>
  </view>

  <view class="status-badge">
    <view class="status-dot"></view>
    <text>极简发起 · 其余字段管家会先填默认</text>
  </view>

  <view wx:if="{{!createdTask}}" class="panel-card">
    <view class="field">
      <view class="field-label">预计几个人？</view>
      <view class="option-grid people-grid">
        <view
          wx:for="{{peopleOptions}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleSelectPeople"
        >{{item.value}}人</view>
      </view>
      <view class="field-hint">不在列表里？下面也可以直接填数字。</view>
    </view>

    <view class="field last">
      <view class="field-label">自定义人数</view>
      <input
        class="field-input"
        type="number"
        value="{{customPeopleInput}}"
        placeholder="例如 12"
        bindinput="handleCustomPeopleInput"
      />
    </view>
  </view>

  <view wx:if="{{!createdTask}}" class="panel-card">
    <view class="field-label">关于其他字段</view>
    <view class="field-hint">时间、地点、口味会让朋友各自填。管家会自动整理冲突，并给出一个最终方案。</view>
  </view>

  <button wx:if="{{!createdTask}}" class="primary-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="handleCreateTask">生成任务链接</button>

  <view wx:if="{{createdTask}}" class="panel-card">
    <view class="field-label">任务已生成</view>
    <view class="field-hint">任务标题：{{createdTask.task.title}}</view>
    <view class="field-hint">taskId：{{createdTask.taskId}}</view>
    <view class="field-hint">邀请 token：{{createdTask.inviteToken}}</view>
    <view class="field-hint" style="word-break: break-all;">分享路径：{{createdTask.sharePath}}</view>
    <view class="chip-row">
      <view class="info-chip hard">createTask</view>
      <view class="info-chip soft">sharePath</view>
      <view class="info-chip soft">inviteToken</view>
      <view class="info-chip">waiting_preferences</view>
    </view>
  </view>

  <view wx:if="{{createdTask}}" class="button-stack">
    <button class="primary-button" open-type="share">分享到群里</button>
    <button class="primary-button" bindtap="handleViewBoard">查看任务看板</button>
    <button class="primary-button" bindtap="handleCopySharePath">复制分享路径</button>
    <button class="primary-button" bindtap="handleCreateAnother">再发起一个</button>
  </view>
</view>
