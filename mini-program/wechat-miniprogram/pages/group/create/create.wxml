<view class="page scaffold-page create-scaffold theme-{{currentTheme}}">
  <view class="create-hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="create-nav-row" style="height: {{navBarHeight}}px; padding-right: {{navRightPadding}}px; --nav-title-side: {{navTitleSidePadding}}px;">
      <view class="group-nav-back-hit" hover-class="group-nav-back-active" bindtap="handleBack" aria-label="返回">
        <view class="group-nav-back-button create-back">
          <text class="group-nav-back-icon create-back-icon">‹</text>
        </view>
      </view>
      <view class="page-heading create-heading">
        <view class="page-title">{{createdTask ? '任务已生成' : '发起约饭'}}</view>
      </view>
    </view>
    <view class="create-hero-subtitle">{{createdTask ? '现在可以分享到群里，或直接查看偏好收集进度。' : '选一下人数就能生成任务链接，朋友点开就能填偏好。'}}</view>
  </view>

  <view class="status-badge">
    <view class="status-dot"></view>
    <text>极简发起 · 后端联调</text>
  </view>

  <view wx:if="{{!createdTask}}" class="panel-card">
    <view class="field">
      <view class="field-label">预计几个人？</view>
      <view class="option-grid people-grid">
        <view
          wx:for="{{peopleOptions}}"
          wx:key="value"
          class="option-cell {{item.active ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="handleSelectPeople"
        >{{item.value}}人</view>
      </view>
      <view class="field-hint">不在列表里？下面也可以直接填数字。</view>
    </view>

    <view class="field last">
      <view class="field-label">自定义人数</view>
      <input
        class="field-input"
        type="number"
        value="{{customPeopleInput}}"
        placeholder="例如 12"
        placeholder-class="field-placeholder"
        bindinput="handleCustomPeopleInput"
      />
    </view>
  </view>

  <view wx:if="{{!createdTask}}" class="panel-card">
    <view class="field-label">关于其他字段</view>
    <view class="field-hint">时间、地点、口味会让朋友各自填。管家会自动整理冲突，并给出一个最终方案。</view>
  </view>

  <button wx:if="{{!createdTask}}" class="primary-button" loading="{{isSubmitting}}" disabled="{{isSubmitting}}" bindtap="handleCreateTask">生成任务链接</button>

  <view wx:if="{{createdTask}}" class="panel-card">
    <view class="field-label">{{createdTask.task.displayTitle || '多人约饭偏好收集中'}}</view>
    <view class="field-hint">{{createdTask.task.displaySummary || '发起人邀请大家填写约饭偏好'}}</view>
    <view class="chip-row">
      <view class="info-chip">{{createdTask.expectedPeopleCount}} 人</view>
      <view class="info-chip soft">{{createdTask.submittedCount}}/{{createdTask.expectedPeopleCount}} 已提交</view>
      <view class="info-chip">点击填写偏好</view>
    </view>
  </view>

  <view wx:if="{{createdTask}}" class="button-stack">
    <button class="primary-button" bindtap="handleFillPreference">我也填写偏好</button>
    <button class="primary-button" open-type="share">分享到群里</button>
    <button class="primary-button" bindtap="handleViewBoard">查看任务看板</button>
    <button class="primary-button" bindtap="handleCreateAnother">再发起一个</button>
  </view>
</view>
