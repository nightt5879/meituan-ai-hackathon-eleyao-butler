.scaffold-page {
  padding: 34rpx 30rpx 48rpx;
}

.page-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.page-back {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  min-width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-muted, #6B6157);
  font-size: 44rpx;
  line-height: 1;
  box-shadow: var(--theme-shadow-card, 0 18rpx 48rpx rgba(22, 78, 63, 0.10));
}

.page-back::after {
  border: 0;
}

.page-heading {
  flex: 1;
  min-width: 0;
  transform: translateX(-4rpx);
}

.page-title {
  color: var(--theme-text, #1F1A15);
  font-size: 40rpx;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 6rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.45;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-ghost, #FFF4EA);
  color: var(--theme-primary-deep, #164E3F);
  font-size: 22rpx;
  font-weight: 800;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--theme-primary, #5AD8B2);
}

.panel-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 28rpx;
  background: var(--theme-card, #FFFFFF);
}

.field {
  margin-bottom: 22rpx;
}

.field.last {
  margin-bottom: 0;
}

.field .primary-button,
.field .ghost-button {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  font-weight: 700;
}

.field-input,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 20rpx;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-text, #1F1A15);
  font-size: 28rpx;
}

.field-input {
  height: 82rpx;
  padding: 0 22rpx;
}

.field-textarea {
  min-height: 160rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.field-hint {
  margin-top: 10rpx;
  color: var(--theme-subtle, #9A8F83);
  font-size: 22rpx;
  line-height: 1.5;
}

.split-grid {
  display: flex;
  gap: 18rpx;
}

.split-grid .field {
  flex: 1;
  min-width: 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}

.info-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-chip-bg, #F2EBDF);
  color: var(--theme-chip-text, #3F3527);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.info-chip.hard {
  background: rgba(192, 74, 58, 0.1);
  color: var(--theme-danger, #C04A3A);
}

.info-chip.soft {
  background: rgba(91, 140, 90, 0.12);
  color: var(--theme-accent, #5B8C5A);
}

.primary-button,
.ghost-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.primary-button + .primary-button,
.ghost-button + .ghost-button,
.primary-button + .ghost-button,
.ghost-button + .primary-button {
  margin-top: 18rpx;
}

.primary-button {
  background: var(--theme-primary, #5AD8B2);
  color: var(--theme-on-primary, #FFFFFF);
}

.ghost-button {
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-muted, #6B6157);
}

.button-stack {
  margin-top: 4rpx;
}

.option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}

.option-cell {
  box-sizing: border-box;
  flex: 1 1 148rpx;
  min-width: 132rpx;
  max-width: 100%;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 999rpx;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-text, #1F1A15);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
}

.option-cell.active {
  border-color: var(--theme-primary, #5AD8B2);
  background: var(--theme-primary, #5AD8B2);
  color: var(--theme-on-primary, #FFFFFF);
}

.people-grid .option-cell {
  flex: 0 1 112rpx;
  min-width: 112rpx;
}

.empty-panel {
  padding: 44rpx 28rpx;
  border: 1rpx dashed var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 28rpx;
  background: var(--theme-card-muted, #FAF6EE);
  text-align: center;
}

.empty-title {
  color: var(--theme-text, #1F1A15);
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.6;
}

/* Inline priority tag used inside .field-label to distinguish hard vs
   soft requirements on the fill page. */
.priority-tag {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  vertical-align: middle;
}

.priority-tag.must {
  background: var(--theme-soft, #DDF8EF);
  color: var(--theme-primary-deep, #164E3F);
}

.priority-tag.nice {
  background: rgba(74, 144, 226, 0.15);
  color: #2B5A8F;
}

/* Adjustment-request inline panel that expands beneath a candidate card. */
.adjustment-panel {
  margin-top: 14rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--theme-border, #C8F1E4);
  border-radius: 18rpx;
  background: var(--theme-soft, #DDF8EF);
}

.adjustment-panel .field-label {
  color: var(--theme-primary-deep, #164E3F);
}

