<view class="page food-page planner-chat-page weekend-page theme-{{currentTheme}}">
  <view class="custom-food-header planner-header">
    <view class="header-back-button" bindtap="handleBack">‹</view>
    <view class="header-online-status status-connected planner-status">
      <view class="header-online-dot"></view>
      <text class="header-online-text">周边规划 · 路线生成</text>
    </view>
  </view>

  <view class="chat-body planner-body">
    <view class="chat-thread">
      <view class="chat-message butler-message">
        <view class="message-avatar ai-mark">幺</view>
        <view class="message-content butler-content planner-wide-content">
          <view class="chat-bubble butler-bubble planner-intro-bubble">
            告诉我时间、预算和想要的状态，我会按“今天吃什么”的方式给你整理 2-3 条轻路线。
          </view>
        </view>
      </view>

      <view class="planner-form-list">
        <view class="shop-card planner-card">
          <view class="planner-card-title">出行时间</view>
          <view class="planner-chip-list scroll-row">
            <view
              wx:for="{{dateOptions}}"
              wx:key="*this"
              class="quick-chip planner-chip {{form.dateLabel === item ? 'selected' : ''}}"
              data-value="{{item}}"
              bindtap="handleDateTap"
            >{{item}}</view>
          </view>

          <view class="planner-field">
            <view class="planner-chip-list">
              <view
                wx:for="{{timeModeOptions}}"
                wx:key="value"
                class="quick-chip planner-chip {{form.timeMode === item.value ? 'selected' : ''}}"
                data-value="{{item.value}}"
                bindtap="handleTimeModeTap"
              >{{item.label}}</view>
            </view>
          </view>

          <view wx:if="{{form.timeMode === 'range'}}" class="planner-two-column planner-field">
            <picker class="planner-column" mode="time" value="{{form.startTime}}" bindchange="handleStartTimeChange">
              <view class="planner-picker-card">
                <view class="planner-picker-label">开始时间</view>
                <view class="planner-picker-value">{{form.startTime}}</view>
              </view>
            </picker>
            <picker class="planner-column" mode="time" value="{{form.endTime}}" bindchange="handleEndTimeChange">
              <view class="planner-picker-card">
                <view class="planner-picker-label">结束时间</view>
                <view class="planner-picker-value">{{form.endTime}}</view>
              </view>
            </picker>
          </view>

          <view wx:if="{{form.timeMode === 'allDay'}}" class="planner-note planner-field">
            当天时间都可以，我会按半日或轻松路线生成。
          </view>
        </view>

        <view class="shop-card planner-card">
          <view class="planner-card-title">预算和起点</view>
          <view class="planner-two-column">
            <view class="planner-column">
              <view class="planner-field-label">预算上限</view>
              <input
                class="planner-input"
                type="number"
                value="{{form.budgetMax}}"
                placeholder="120"
                placeholder-class="manual-placeholder"
                data-field="budgetMax"
                bindinput="handleInput"
              />
              <view class="planner-helper">元 / 人</view>
            </view>
            <view class="planner-column">
              <view class="planner-field-label">出发起点</view>
              <input
                class="planner-input"
                value="{{form.startArea}}"
                placeholder="学校周边"
                placeholder-class="manual-placeholder"
                data-field="startArea"
                bindinput="handleInput"
              />
            </view>
          </view>
        </view>

        <view class="shop-card planner-card">
          <view class="planner-card-title">这次想要什么感觉</view>
          <view class="planner-field">
            <view class="planner-field-label">心情</view>
            <view class="planner-chip-list">
              <view
                wx:for="{{moodOptions}}"
                wx:key="value"
                class="quick-chip planner-chip {{item.active ? 'selected' : ''}}"
                data-field="mood"
                data-value="{{item.value}}"
                bindtap="handleSelectOption"
              >{{item.value}}</view>
            </view>
          </view>

          <view class="planner-field">
            <view class="planner-field-label">体力</view>
            <view class="planner-chip-list">
              <view
                wx:for="{{energyOptions}}"
                wx:key="value"
                class="quick-chip planner-chip {{item.active ? 'selected' : ''}}"
                data-field="energyLevel"
                data-value="{{item.value}}"
                bindtap="handleSelectOption"
              >{{item.value}}</view>
            </view>
          </view>

          <view class="planner-field">
            <view class="planner-field-label">同行人</view>
            <view class="planner-chip-list">
              <view
                wx:for="{{companionOptions}}"
                wx:key="value"
                class="quick-chip planner-chip {{item.active ? 'selected' : ''}}"
                data-field="companions"
                data-value="{{item.value}}"
                bindtap="handleSelectOption"
              >{{item.value}}</view>
            </view>
          </view>
        </view>

        <view class="shop-card planner-card">
          <view class="planner-card-title">兴趣标签</view>
          <view class="planner-chip-list">
            <view
              wx:for="{{interestOptions}}"
              wx:key="value"
              class="quick-chip planner-chip {{item.active ? 'selected' : ''}}"
              data-value="{{item.value}}"
              bindtap="handleToggleInterest"
            >{{item.emoji}} {{item.label}}</view>
          </view>
        </view>

        <view class="shop-card planner-card">
          <view class="planner-card-title">一句话补充</view>
          <textarea
            class="planner-textarea"
            value="{{form.rawText}}"
            maxlength="200"
            placeholder="例如：不想排队，想找能坐下来聊天和拍照的地方。"
            placeholder-class="manual-placeholder"
            data-field="rawText"
            bindinput="handleInput"
          ></textarea>
        </view>
      </view>

      <view wx:if="{{hasError}}" class="recommendation-notice planner-state">
        生成失败：{{errorMessage}}
      </view>

      <view wx:if="{{isSubmitting}}" class="recommendation-notice planner-state">
        正在综合天气、预算、体力和返程时间。
      </view>

      <view wx:if="{{showEmptyState && !isSubmitting}}" class="recommendation-notice planner-state">
        提交后会展示出门路线、折中路线、雨天或低体力备选。
      </view>

      <view wx:if="{{hasPlan}}" class="planner-result-list">
        <view wx:if="{{hasBackendNotice}}" class="recommendation-notice">
          {{backendNotice}}
        </view>

        <view class="shop-card planner-card planner-weather-card {{plan.weather.fallback ? 'featured' : ''}}">
          <view class="shop-header">
            <view class="shop-title-wrap">
              <view class="shop-rank">天气</view>
              <view class="shop-name">{{plan.weather.summary}}</view>
            </view>
            <view class="shop-type">{{plan.weather.sourceLabel}}</view>
          </view>
          <view wx:if="{{plan.weatherNotice}}" class="shop-risk">
            <text class="shop-section-label">提醒</text>{{plan.weatherNotice}}
          </view>
          <view class="matched-tags-row">
            <text class="shop-section-label">来源</text>
            <view class="matched-tags">
              <text class="matched-tag">天气 {{plan.source.weather}}</text>
              <text class="matched-tag">POI {{plan.source.poi}}</text>
              <text class="matched-tag">规划 {{plan.source.planner}}</text>
            </view>
          </view>
        </view>

        <view class="chat-message butler-message">
          <view class="message-avatar ai-mark">幺</view>
          <view class="message-content butler-content planner-wide-content">
            <view class="chat-bubble butler-bubble">
              已生成 {{plan.routeCountText}}，planId {{plan.planId}}。你可以复制喜欢的邀约文案。
            </view>
          </view>
        </view>

        <view
          wx:for="{{plan.routes}}"
          wx:key="id"
          class="shop-card planner-card planner-route-card {{index === 0 ? 'featured' : ''}}"
        >
          <view class="shop-header">
            <view class="shop-title-wrap">
              <view wx:if="{{index === 0}}" class="shop-rank">首推</view>
              <view class="shop-name">{{item.title}}</view>
            </view>
            <view class="shop-type">{{item.typeLabel}}</view>
          </view>

          <view class="shop-meta">
            <view>预算 {{item.estimatedBudgetText}}</view>
            <view>时长 {{item.estimatedDurationText}}</view>
            <view>{{item.transport}}</view>
          </view>

          <view class="planner-route-summary">{{item.summary}}</view>

          <view class="planner-route-block">
            <view class="planner-route-block-title">时间线</view>
            <view wx:if="{{item.hasTimeline}}" class="planner-timeline">
              <view
                wx:for="{{item.timeline}}"
                wx:for-item="step"
                wx:key="id"
                class="planner-timeline-item"
              >
                <view class="planner-timeline-head">
                  <text class="planner-timeline-time">{{step.time}}</text>
                  <text class="planner-timeline-title">{{step.title}}</text>
                </view>
                <view wx:if="{{step.placeName}}" class="planner-timeline-place">{{step.placeName}}</view>
                <view wx:if="{{step.activity}}" class="planner-timeline-activity">{{step.activity}}</view>
                <view wx:if="{{step.durationMinutes}}" class="planner-timeline-duration">预计停留 {{step.durationMinutes}} 分钟</view>
              </view>
            </view>
            <view wx:else class="planner-note">
              暂无详细时间线，可根据路线摘要灵活安排。
            </view>
          </view>

          <view wx:if="{{item.hasChecks}}" class="planner-route-block">
            <view class="planner-route-block-title">自检结果</view>
            <view class="planner-check-grid">
              <view
                wx:for="{{item.selfChecks}}"
                wx:for-item="check"
                wx:key="label"
                class="planner-check-item"
              >
                <view class="planner-check-top">
                  <text>{{check.label}}</text>
                  <text>{{check.statusText}}</text>
                </view>
                <view class="planner-check-detail">{{check.detail}}</view>
              </view>
            </view>
          </view>

          <view wx:if="{{item.hasRisks}}" class="planner-route-block">
            <view class="planner-route-block-title">风险提示</view>
            <view class="planner-risk-list">
              <view
                wx:for="{{item.risks}}"
                wx:for-item="risk"
                wx:key="*this"
                class="planner-risk-item"
              >{{risk}}</view>
            </view>
          </view>

          <view class="planner-route-invite">
            <view class="planner-route-invite-text">{{item.inviteText}}</view>
            <button class="planner-secondary-button" data-index="{{index}}" bindtap="handleCopyInvite">复制邀约</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="reply-dock planner-action-dock">
    <view class="slot-summary-card">
      <view class="slot-summary-bar">
        <view class="slot-summary-text">{{form.timeWindow}} · {{form.startArea}} · {{form.budgetMax}} 元/人</view>
      </view>
      <view class="slot-summary-hint">当前条件仅用于本次周边规划，不会写入长期偏好。</view>
    </view>
    <view class="input-bar">
      <button
        class="planner-secondary-button"
        wx:if="{{hasPlan}}"
        bindtap="handleClearResult"
      >重新填写</button>
      <button
        class="planner-primary-button {{isSubmitting ? 'disabled-button' : ''}}"
        loading="{{isSubmitting}}"
        disabled="{{isSubmitting}}"
        bindtap="handleCreatePlan"
      >{{isSubmitting ? '生成中' : '生成轻路线'}}</button>
    </view>
  </view>
</view>
