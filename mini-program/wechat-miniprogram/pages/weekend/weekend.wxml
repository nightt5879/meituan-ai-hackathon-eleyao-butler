<view class="page weekend-page theme-{{currentTheme}}">
  <view class="weekend-bar">
    <button class="weekend-back" bindtap="handleBack">‹</button>
    <view>
      <view class="weekend-title">周末规划</view>
      <view class="weekend-subtitle">页面壳已就位，后续接路线、天气、人流和 Agent 自检。</view>
    </view>
  </view>

  <view class="hero-card">
    <view class="hero-mark ai-mark">幺</view>
    <view class="hero-eyebrow">即将上线 · UI scaffold</view>
    <view class="hero-title">把 2 小时周末空档，变成一条可执行路线</view>
    <view class="hero-desc">后续这里会输入时间、地点、预算和兴趣，生成吃喝玩组合方案。</view>
  </view>

  <view class="input-card">
    <view class="field-label">想怎么过这个周末？</view>
    <textarea class="weekend-textarea" placeholder="例如：周六下午想在学校附近轻松逛逛，预算 100 内，不想太累。"></textarea>
    <button class="primary-button" bindtap="handleCreatePlan">生成周末规划</button>
  </view>

  <view class="module-list">
    <view wx:for="{{cards}}" wx:key="title" class="module-card">
      <view class="module-icon">+</view>
      <view>
        <view class="module-title">{{item.title}}</view>
        <view class="module-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="empty-panel">
    <view class="empty-title">真实规划能力待接入</view>
    <view class="empty-desc">当前不展示假路线。下一步接入 createPlan / getPlan 后，这里会展示候选路线、自检结果和可复制邀约文案。</view>
  </view>
</view>
