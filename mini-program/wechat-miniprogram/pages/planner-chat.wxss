.planner-chat-page {
  padding: 0;
  display: flex;
  flex-direction: column;
  background: var(--theme-bg, #FFF8EF);
}

.planner-body {
  padding-bottom: 28rpx;
}

.planner-status {
  max-width: 460rpx;
}

.planner-wide-content {
  max-width: 626rpx;
}

.planner-intro-bubble {
  font-weight: 600;
}

.planner-form-list,
.planner-result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 2rpx;
  padding-left: 68rpx;
}

.planner-card {
  box-sizing: border-box;
  width: 100%;
}

.planner-card-title {
  margin-bottom: 18rpx;
  color: var(--theme-text, #3A2A1A);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.35;
}

.planner-card-desc {
  margin-top: -8rpx;
  margin-bottom: 18rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  line-height: 1.5;
}

.planner-field {
  margin-top: 20rpx;
}

.planner-field:first-child {
  margin-top: 0;
}

.planner-field-label {
  margin-bottom: 12rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.planner-input,
.planner-textarea {
  box-sizing: border-box;
  width: 100%;
  border: 2rpx solid var(--theme-border, #F3DDC7);
  background: var(--theme-bg, #FFF8EF);
  color: var(--theme-text, #3A2A1A);
  font-size: 27rpx;
}

.planner-input {
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  line-height: 76rpx;
}

.planner-textarea {
  min-height: 168rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  line-height: 1.55;
}

.planner-helper {
  margin-top: 10rpx;
  color: var(--theme-subtle, #9A8F83);
  font-size: 22rpx;
  line-height: 1.5;
}

.planner-two-column {
  display: flex;
  gap: 14rpx;
}

.planner-column {
  flex: 1;
  min-width: 0;
}

.planner-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.planner-chip-list.scroll-row {
  flex-wrap: nowrap;
  overflow-x: auto;
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.quick-chip.planner-chip {
  flex-shrink: 0;
  min-height: 54rpx;
}

.planner-picker-card {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 13rpx 22rpx;
  border: 2rpx solid var(--theme-border, #F3DDC7);
  border-radius: 22rpx;
  background: var(--theme-bg, #FFF8EF);
}

.planner-picker-label {
  color: var(--theme-muted, #8A6A4F);
  font-size: 21rpx;
  line-height: 1.2;
}

.planner-picker-value {
  margin-top: 5rpx;
  color: var(--theme-text, #3A2A1A);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.25;
}

.planner-note {
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-radius: 18rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  line-height: 1.5;
}

.planner-action-dock {
  flex-shrink: 0;
}

.planner-primary-button,
.planner-secondary-button {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.planner-primary-button {
  height: 76rpx;
  background: var(--theme-primary, #FF8A3D);
  color: var(--theme-on-primary, #FFFFFF);
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 61, 0.18);
}

.planner-secondary-button {
  height: 68rpx;
  border: 2rpx solid var(--theme-primary, #FF8A3D);
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-primary, #FF8A3D);
  line-height: 66rpx;
}

.planner-primary-button::after,
.planner-secondary-button::after {
  border: 0;
}

.planner-primary-button.disabled-button {
  opacity: 0.68;
}

.input-bar .planner-primary-button,
.input-bar .planner-secondary-button {
  flex: 1;
  min-width: 0;
}

.planner-link-tags,
.planner-source-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.planner-state {
  margin-left: 68rpx;
}

.planner-result-list .recommendation-notice {
  margin: 0;
}

.planner-result-list .chat-message {
  margin-left: -68rpx;
}

.planner-weather-card .shop-name,
.planner-route-card .shop-name {
  font-size: 30rpx;
}

.planner-route-summary {
  margin-top: 16rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 25rpx;
  line-height: 1.55;
}

.planner-route-block {
  margin-top: 18rpx;
}

.planner-route-block-title {
  margin-bottom: 12rpx;
  color: var(--theme-text, #3A2A1A);
  font-size: 25rpx;
  font-weight: 800;
}

.planner-timeline {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.planner-timeline-item {
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-radius: 18rpx;
  background: var(--theme-card, #FFFDF8);
}

.planner-timeline-head {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.planner-timeline-time {
  color: var(--theme-primary-deep, #FF8A3D);
  font-size: 24rpx;
  font-weight: 800;
}

.planner-timeline-title {
  color: var(--theme-text, #3A2A1A);
  font-size: 25rpx;
  font-weight: 800;
}

.planner-timeline-place,
.planner-timeline-activity,
.planner-timeline-duration,
.planner-check-detail {
  margin-top: 8rpx;
  color: var(--theme-muted, #8A6A4F);
  font-size: 23rpx;
  line-height: 1.5;
}

.planner-check-grid,
.planner-risk-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.planner-check-item,
.planner-risk-item {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--theme-soft, #FFF1E3);
  color: var(--theme-muted, #8A6A4F);
  font-size: 24rpx;
  line-height: 1.45;
}

.planner-check-top {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  color: var(--theme-text, #3A2A1A);
  font-weight: 800;
}

.planner-route-invite {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid var(--theme-border, #F3DDC7);
  border-radius: 18rpx;
  background: var(--theme-risk-bg, #FFF1E3);
}

.planner-route-invite-text {
  color: var(--theme-risk-text, #6D4B32);
  font-size: 24rpx;
  line-height: 1.55;
}

.planner-route-invite .planner-secondary-button {
  margin-top: 14rpx;
}

@media (max-width: 360px) {
  .planner-two-column {
    flex-direction: column;
  }
}
