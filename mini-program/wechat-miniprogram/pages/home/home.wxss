.home-page {
  padding-top: 0;
  padding-bottom: 24rpx;
}

.home-bar {
  margin-bottom: 28rpx;
}

.home-intro {
  padding: 0 var(--page-x);
}

.home-intro__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.home-intro .el-hero {
  font-size: 48rpx;
  line-height: 1.12;
}

.line-break {
  display: block;
}

.home-intro .line-break {
  display: inline;
}

.home-page .el-section__head {
  margin-bottom: 6rpx;
}

.home-page .el-section__title {
  font-size: 24rpx;
}

.home-page .el-section__sub,
.home-page .el-section__no {
  font-size: 20rpx;
}

.home-entry-list {
  margin: 24rpx var(--page-x) 20rpx;
  border-top: 1rpx solid var(--hair);
  border-bottom: 1rpx solid var(--hair);
}

.home-entry {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--hair);
}

.home-entry:last-child {
  border-bottom: 0;
}

.home-entry:active,
.recent-card:active,
.memory-row:active {
  background: var(--accent-soft);
}

.home-entry__no {
  width: 38rpx;
  padding-top: 5rpx;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-cap);
  letter-spacing: 1rpx;
}

.home-entry__body {
  flex: 1;
  min-width: 0;
}

.home-entry__title-row {
  display: flex;
  align-items: baseline;
  gap: var(--s-2);
}

.home-entry__title {
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 650;
  line-height: 1.16;
}

.home-entry__tag {
  padding: 1rpx 8rpx;
  border: 1rpx solid var(--accent);
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: var(--t-nano);
  letter-spacing: 1rpx;
}

.home-entry__desc {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.35;
}

.home-entry__meta {
  margin-top: 5rpx;
  color: var(--subtle);
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.home-entry__arrow {
  flex-shrink: 0;
  padding-top: 5rpx;
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1;
}

.recent-section,
.memory-section {
  padding-bottom: 18rpx;
}

.recent-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0 0;
}

.recent-price {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 70rpx;
  height: 70rpx;
  background: var(--accent);
  color: var(--on-accent);
  font-family: var(--font-mono);
  font-size: 30rpx;
  font-weight: 600;
}

.recent-copy {
  flex: 1;
  min-width: 0;
}

.recent-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-summary {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.35;
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.recent-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 8rpx;
}

.memory-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 0 0;
}

.memory-row__main {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 2rpx;
  color: var(--ink-2);
  font-size: 24rpx;
}

.memory-row__hint {
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.3;
}

.panel-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(14, 14, 12, 0.42);
}

.bottom-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  padding: var(--s-5) var(--page-x) calc(var(--s-5) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hair-strong);
  background: var(--bg);
  overflow-y: auto;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--s-4);
  margin-bottom: var(--s-5);
}

.panel-title {
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--t-h1);
  font-weight: 650;
}

.panel-desc {
  margin-top: var(--s-2);
  color: var(--muted);
  font-size: var(--t-body);
  line-height: 1.55;
}

.panel-close {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid var(--hair);
  background: var(--card);
  color: var(--ink);
  font-size: 38rpx;
  line-height: 60rpx;
}

.empty-state {
  padding: var(--s-6) 0;
}

.empty-title {
  color: var(--ink);
  font-size: var(--t-body-l);
  font-weight: 600;
}

.empty-desc {
  margin-top: var(--s-2);
  color: var(--muted);
  font-size: var(--t-body);
  line-height: 1.6;
}

.history-list {
  border-top: 1rpx solid var(--hair);
}

.history-item {
  display: flex;
  gap: var(--s-3);
  padding: var(--s-4) 0;
  border-bottom: 1rpx solid var(--hair);
}

.history-index {
  width: 44rpx;
  color: var(--muted);
  font-family: var(--font-mono);
  font-size: var(--t-cap);
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-names {
  color: var(--ink);
  font-size: var(--t-body);
  font-weight: 600;
}

.history-summary {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: var(--t-cap);
  line-height: 1.5;
}

.history-time {
  margin-top: 8rpx;
  color: var(--subtle);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
}
