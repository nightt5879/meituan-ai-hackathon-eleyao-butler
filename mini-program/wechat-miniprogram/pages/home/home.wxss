.home-page {
  padding: 92rpx 40rpx 48rpx;
}

.home-topline {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-bottom: 28rpx;
  font-size: 26rpx;
}

.hello-muted {
  color: var(--theme-muted, #6B6157);
}

.hello-name {
  color: var(--theme-text, #1F1A15);
  font-weight: 700;
}

.home-hero {
  margin-bottom: 24rpx;
}

.home-hero .section-title {
  margin-bottom: 18rpx;
  font-size: 60rpx;
}

.line-break {
  display: block;
}

.utility-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.utility-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 999rpx;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
}

.utility-icon {
  color: var(--theme-primary, #F07030);
  font-size: 24rpx;
  line-height: 1;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.home-entry-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  height: 156rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 28rpx;
  background: var(--theme-card, #FFFFFF);
  box-shadow: 0 2rpx 20rpx rgba(240, 112, 48, 0.10);
}

.home-entry-card:active {
  background: var(--theme-soft, rgba(240, 112, 48, 0.06));
}

.entry-mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  color: var(--theme-primary-deep, #C95A24);
  font-size: 34rpx;
  font-weight: 800;
}

.food-icon {
  background: var(--theme-primary-ghost, rgba(240, 112, 48, 0.06));
}

.group-icon {
  background: var(--theme-primary-ghost, rgba(240, 112, 48, 0.06));
  color: var(--theme-primary-deep, #C95A24);
}

.weekend-icon {
  background: var(--theme-primary-ghost, rgba(240, 112, 48, 0.06));
  color: var(--theme-primary-deep, #C95A24);
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.entry-title {
  color: var(--theme-text, #1F1A15);
  font-size: 33rpx;
  font-weight: 800;
}

.entry-desc {
  margin-top: 10rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 25rpx;
  line-height: 1.45;
}

.entry-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.entry-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--theme-primary-ghost, rgba(240, 112, 48, 0.06));
  color: var(--theme-primary, #F07030);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.recent-block {
  margin-top: 4rpx;
}

.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: var(--theme-subtle, #9A8F83);
  font-size: 24rpx;
}

.recent-link {
  color: var(--theme-primary, #F07030);
  font-weight: 700;
}

.recent-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 28rpx;
  background: var(--theme-card, #FFFFFF);
  box-shadow: 0 2rpx 20rpx rgba(240, 112, 48, 0.10);
}

.recent-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.recent-title {
  min-width: 0;
  color: var(--theme-text, #1F1A15);
  font-size: 27rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  flex-shrink: 0;
  color: var(--theme-subtle, #9A8F83);
  font-size: 22rpx;
}

.recent-summary {
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.55;
}

.panel-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.36);
}

.bottom-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  padding: 30rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--theme-bg, #FDF8F3);
  overflow-y: auto;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.panel-title {
  color: var(--theme-text, #1F1A15);
  font-size: 34rpx;
  font-weight: 800;
}

.panel-desc {
  margin-top: 8rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.55;
}

.panel-close {
  flex-shrink: 0;
  width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: var(--theme-card, #FFFFFF);
  color: var(--theme-muted, #6B6157);
  font-size: 38rpx;
  line-height: 54rpx;
}

.theme-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.theme-card {
  box-sizing: border-box;
  width: calc(50% - 9rpx);
  overflow: hidden;
  border: 2rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 26rpx;
  background: var(--theme-card, #FFFFFF);
}

.theme-card.active {
  border-color: var(--theme-primary, #F07030);
}

.theme-preview {
  padding: 18rpx;
  min-height: 154rpx;
}

.swatch-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.swatch {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
}

.mini-chat {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.72);
}

.mini-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 16rpx;
  font-weight: 800;
}

.mini-line {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(31, 26, 21, 0.12);
}

.mini-bubble {
  float: right;
  margin-top: 12rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
}

.theme-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
}

.theme-name {
  color: var(--theme-text, #1F1A15);
  font-size: 25rpx;
  font-weight: 700;
}

.theme-key {
  margin-top: 4rpx;
  color: var(--theme-subtle, #9A8F83);
  font-size: 19rpx;
}

.theme-check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid var(--theme-border-strong, rgba(45, 30, 15, 0.14));
  border-radius: 50%;
  color: transparent;
  font-size: 22rpx;
  font-weight: 800;
}

.theme-check.checked {
  border-color: var(--theme-primary, #F07030);
  background: var(--theme-primary, #F07030);
  color: var(--theme-on-primary, #FFFFFF);
}

.empty-state {
  padding: 64rpx 30rpx 44rpx;
  text-align: center;
}

.empty-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  font-size: 56rpx;
}

.empty-title {
  color: var(--theme-text, #1F1A15);
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 25rpx;
  line-height: 1.6;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 24rpx;
  background: var(--theme-card, #FFFFFF);
}

.history-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--theme-primary-ghost, rgba(240, 112, 48, 0.06));
  color: var(--theme-primary, #F07030);
  font-size: 24rpx;
  font-weight: 800;
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-names {
  color: var(--theme-text, #1F1A15);
  font-size: 27rpx;
  font-weight: 700;
}

.history-summary {
  margin-top: 8rpx;
  color: var(--theme-muted, #6B6157);
  font-size: 24rpx;
  line-height: 1.5;
}

.history-time {
  margin-top: 8rpx;
  color: var(--theme-subtle, #9A8F83);
  font-size: 22rpx;
}

/* Compact home entry → 管家记忆 page (user-managed stable preferences). */
.memory-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 28rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--theme-border, rgba(45, 30, 15, 0.08));
  border-radius: 28rpx;
  background: var(--theme-card, #FFFFFF);
  box-shadow: 0 2rpx 20rpx rgba(240, 112, 48, 0.08);
  transition: background-color 160ms ease, box-shadow 160ms ease;
  -webkit-font-smoothing: antialiased;
}

.memory-entry:active {
  background: var(--theme-soft, rgba(240, 112, 48, 0.06));
  box-shadow: 0 2rpx 14rpx rgba(240, 112, 48, 0.08);
}

.memory-icon {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(240, 112, 48, 0.04);
  color: var(--theme-primary-deep, #C95A24);
  font-size: 26rpx;
  font-weight: 700;
}

.memory-copy {
  flex: 1;
  min-width: 0;
}

.memory-title {
  color: var(--theme-text, #211A16);
  font-size: 27rpx;
  font-weight: 700;
}

.memory-desc {
  margin-top: 4rpx;
  color: var(--theme-muted, #7A6D63);
  font-size: 22rpx;
  line-height: 1.4;
}

.memory-arrow {
  flex-shrink: 0;
  color: var(--theme-muted, #7A6D63);
  font-size: 32rpx;
  font-weight: 700;
}

.theme-dark .memory-entry {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.12);
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.24);
}

.theme-dark .memory-entry:active {
  background: rgba(255, 255, 255, 0.10);
}

.theme-dark .memory-icon {
  background: rgba(255, 159, 67, 0.18);
  color: var(--theme-primary, #F07030);
}
