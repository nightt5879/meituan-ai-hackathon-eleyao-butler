<view class="el-page home-page theme-{{currentTheme}}">
  <view class="el-bar home-bar">
    <view class="left">饿了幺 · 番禺大学城</view>
    <view class="right">
      <text class="el-dot"></text>
      <text>内测</text>
    </view>
  </view>

  <view class="home-intro">
    <view class="el-hero">晚饭时间到了，<text class="line-break"></text>小幺。</view>
    <view class="el-text el-text--muted home-intro__desc">下面三件事可以现在做。</view>
  </view>

  <view class="home-entry-list">
    <view class="home-entry home-entry--primary" bindtap="goToFood">
      <view class="home-entry__no">01</view>
      <view class="home-entry__body">
        <view class="home-entry__title">今天吃什么</view>
        <view class="home-entry__desc">回答几个问题，给你 2-3 家可现在吃的店</view>
        <view class="home-entry__meta">单人 · 预算 · 忌口 · 距离</view>
      </view>
      <view class="home-entry__arrow">→</view>
    </view>

    <view class="home-entry" bindtap="goToGroupDining">
      <view class="home-entry__no">02</view>
      <view class="home-entry__body">
        <view class="home-entry__title-row">
          <view class="home-entry__title">发起约饭</view>
          <view class="home-entry__tag">LIVE</view>
        </view>
        <view class="home-entry__desc">创建任务，分享给成员填写偏好</view>
        <view class="home-entry__meta">多人 · 冲突识别 · 候选方案</view>
      </view>
      <view class="home-entry__arrow">→</view>
    </view>

    <view class="home-entry" bindtap="goToWeekend">
      <view class="home-entry__no">03</view>
      <view class="home-entry__body">
        <view class="home-entry__title">周末规划</view>
        <view class="home-entry__desc">按天气、预算和体力排 3 条轻路线</view>
        <view class="home-entry__meta">路线 · 天气 · 低体力备选</view>
      </view>
      <view class="home-entry__arrow">→</view>
    </view>
  </view>

  <view class="el-section recent-section">
    <view class="el-section__head">
      <view class="el-section__no">04</view>
      <view class="el-section__title">最近一次</view>
      <view class="el-section__rule"></view>
      <view class="el-section__sub">{{recentRecordTime}}</view>
    </view>
    <view class="recent-card" bindtap="openHistoryPanel">
      <view class="recent-price">¥</view>
      <view class="recent-copy">
        <view class="recent-title">{{recentRecordTitle}}</view>
        <view class="recent-summary">{{recentRecordSummary}}</view>
        <view class="recent-chips">
          <text class="el-chip el-chip--mono">HISTORY</text>
          <text class="el-chip">偏好记录</text>
        </view>
      </view>
      <view class="home-entry__arrow">→</view>
    </view>
  </view>

  <view class="el-section memory-section">
    <view class="el-section__head">
      <view class="el-section__no">05</view>
      <view class="el-section__title">管家记忆</view>
      <view class="el-section__rule"></view>
      <view class="el-section__sub">可控</view>
    </view>
    <view class="memory-row" bindtap="goToMemory">
      <view class="memory-row__main">
        <text>忌口、辣度与偏好授权</text>
        <text class="memory-row__hint">随时修改，长期记录由你决定</text>
      </view>
      <view class="home-entry__arrow">→</view>
    </view>
  </view>

  <view wx:if="{{showHistoryPanel}}" class="panel-mask" bindtap="closeHistoryPanel">
    <view class="bottom-panel history-panel" catchtap="noop">
      <view class="panel-header">
        <view>
          <view class="panel-title">偏好记录</view>
          <view class="panel-desc">最近 5 次选择会留在这里，方便继续调整。</view>
        </view>
        <button class="panel-close" bindtap="closeHistoryPanel">×</button>
      </view>

      <view wx:if="{{!hasHistoryRecords}}" class="empty-state">
        <view class="empty-title">还没有偏好记录</view>
        <view class="empty-desc">在结果页选择「记住这个偏好」后，我会把场景、预算、距离和推荐结果记下来。</view>
      </view>

      <view wx:else class="history-list">
        <view wx:for="{{historyRecords}}" wx:key="id" class="history-item">
          <view class="history-index">{{item.indexText}}</view>
          <view class="history-copy">
            <view class="history-names">{{item.names}}</view>
            <view class="history-summary">{{item.summary}}</view>
            <view class="history-time">{{item.time}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
