@import "styles/tokens.wxss";

page {
  --theme-bg: var(--bg);
  --theme-bg-soft: var(--bg-soft);
  --theme-primary: var(--accent);
  --theme-primary-deep: var(--accent-ink);
  --theme-primary-soft: var(--accent-soft);
  --theme-primary-ghost: var(--accent-soft);
  --theme-soft: var(--bg-soft);
  --theme-secondary: var(--accent-soft);
  --theme-card: var(--card);
  --theme-card-muted: var(--bg-soft);
  --theme-text: var(--ink);
  --theme-muted: var(--muted);
  --theme-subtle: var(--subtle);
  --theme-border: var(--hair);
  --theme-border-strong: var(--hair-strong);
  --theme-chip-bg: var(--bg-soft);
  --theme-chip-text: var(--ink-2);
  --theme-on-primary: var(--on-accent);
  --theme-ai-bubble: var(--card);
  --theme-user-bubble: var(--accent-soft);
  --theme-user-text: var(--accent-ink);
  --theme-accent: var(--accent);
  --theme-warn: var(--warn);
  --theme-danger: var(--bad);
  --theme-risk-bg: var(--warn-soft);
  --theme-risk-text: var(--warn);
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--s-6) var(--page-x);
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
}

.section-title {
  margin: 0 0 var(--s-3);
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--t-h1);
  font-weight: 500;
  line-height: 1.22;
  letter-spacing: 0;
}

.section-desc {
  margin: 0;
  color: var(--muted);
  font-size: var(--t-body);
  line-height: 1.6;
}

.ai-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-2);
  background: var(--accent);
  color: var(--on-accent);
  font-family: var(--font-serif);
  font-weight: 600;
}

button {
  border-radius: var(--r-2);
  font-family: inherit;
}

button::after {
  border: 0;
}
