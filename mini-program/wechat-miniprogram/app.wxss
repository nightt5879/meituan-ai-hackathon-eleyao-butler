  --theme-primary-deep: #C95A24;
  --theme-primary-soft: #FCEFE7;
  --theme-primary-ghost: rgba(240, 112, 48, 0.06);
  --theme-soft: rgba(240, 112, 48, 0.06);
  --theme-secondary: #FCEFE7;
