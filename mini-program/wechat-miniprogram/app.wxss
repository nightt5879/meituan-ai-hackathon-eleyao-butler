page {
  min-height: 100vh;
  background: #FDF8F3;
  color: #211A16;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: var(--theme-bg, #FDF8F3);
  color: var(--theme-text, #211A16);
}

