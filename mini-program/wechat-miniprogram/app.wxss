.theme-pink {
  --theme-bg: #FFF3F7;
  --theme-bg-soft: #FFEAF1;
  --theme-primary: #FF9FBC;
  --theme-primary-deep: #C94873;
  --theme-primary-soft: #FFD6E3;
  --theme-primary-ghost: rgba(255, 159, 188, 0.18);
  --theme-soft: #FFD6E3;
  --theme-secondary: #FFD6E3;
  --theme-card: #FFFFFF;
  --theme-card-muted: #FFF9FB;
  --theme-text: #5A2A3A;
  --theme-muted: #9A6072;
  --theme-subtle: #C48A9C;
  --theme-border: rgba(90, 42, 58, 0.12);
  --theme-border-strong: rgba(90, 42, 58, 0.20);
  --theme-chip-bg: #FFE5EE;
  --theme-chip-text: #5A2A3A;
  --theme-on-primary: #5A2A3A;
  --theme-ai-bubble: #FFFFFF;
  --theme-user-bubble: #FFE5EE;
