.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: var(--s-6) var(--page-x);
  background: var(--theme-bg, var(--bg));
  color: var(--theme-text, var(--ink));
  font-family: var(--font-sans);
}

.section-title {
  margin: 0 0 var(--s-3);
  color: var(--theme-text, var(--ink));
  font-family: var(--font-serif);
  font-size: var(--t-h1);
  font-weight: 700;
  line-height: 1.22;
  letter-spacing: 0;
}

.section-desc {
  margin: 0;
  color: var(--theme-muted, var(--muted));
  font-size: var(--t-body);
  line-height: 1.6;
}

.ai-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-2);
  background: var(--theme-primary, var(--accent));
  color: var(--theme-on-primary, var(--on-accent));
  font-family: var(--font-serif);
  font-weight: 700;
}

button {
  border-radius: var(--r-2);
  font-family: inherit;
}

button::after {
  border: 0;
}
