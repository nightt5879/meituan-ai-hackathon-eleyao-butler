page {
  min-height: 100vh;
  background: #EFFFF8;
  color: #164E3F;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: var(--theme-bg, #EFFFF8);
  color: var(--theme-text, #164E3F);
}

.theme-sky-blue,
.theme-blue {
  --theme-bg: #EEF9FF;
  --theme-bg-soft: #E1F4FF;
  --theme-primary: #6EC6FF;
  --theme-primary-deep: #1B79B2;
  --theme-primary-soft: #DDF3FF;
  --theme-primary-ghost: rgba(110, 198, 255, 0.16);
  --theme-soft: #DDF3FF;
  --theme-secondary: #BDEBFF;
  --theme-card: #FFFFFF;
  --theme-card-muted: #F7FCFF;
  --theme-text: #1F3A5F;
  --theme-muted: #5C789A;
  --theme-subtle: #86A5C5;
  --theme-border: rgba(31, 58, 95, 0.12);
  --theme-border-strong: rgba(31, 58, 95, 0.20);
  --theme-chip-bg: #DDF3FF;
  --theme-chip-text: #1F3A5F;
  --theme-on-primary: #14324D;
  --theme-ai-bubble: #FFFFFF;
  --theme-user-bubble: #DDF3FF;
  --theme-user-text: #1F3A5F;
  --theme-accent: #4F9FE6;
  --theme-warn: #C9821D;
  --theme-danger: #D94E56;
  --theme-risk-bg: #FFF7DE;
  --theme-risk-text: #684F12;
  --theme-shadow-card: 0 18rpx 48rpx rgba(31, 58, 95, 0.10);
  --theme-shadow-button: 0 12rpx 30rpx rgba(110, 198, 255, 0.28);
}

