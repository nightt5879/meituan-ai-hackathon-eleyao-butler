}

.section-title {
  margin: 0 0 16rpx;
  color: var(--theme-text, #1F1A15);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
  letter-spacing: 0;
}

.section-desc {
  margin: 0;
  color: var(--theme-muted, #6B6157);
  font-size: 28rpx;
  line-height: 1.6;
}

.ai-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--theme-primary, #F07030);
  color: var(--theme-on-primary, #FFFFFF);
  font-weight: 800;
  box-shadow: 0 14rpx 34rpx rgba(240, 112, 48, 0.18);
}

.theme-dark .ai-mark {
  box-shadow: 0 14rpx 34rpx rgba(244, 146, 90, 0.16);
}

button {
  border-radius: 16rpx;
  font-family: inherit;
}

button::after {
  border: 0;
}
