/* ════════════════════════════════════════════════════════════════════════
   饿了幺 · 公告板 设计系统 · WXSS Tokens
   ────────────────────────────────────────────────────────────────────────
   基础 token 会被 app.wxss 中的 theme-* 主题类覆盖。
   原则：一个底（近白）+ 一个墨（近黑）+ 一个绿（苔藓），克制使用 warn/bad。
   字体：思源宋大标题 / 苹方正文 / IBM Plex Mono 数字。
   ════════════════════════════════════════════════════════════════════════ */

page {
  /* ── Surfaces ─────────────────────────────────────────────────────── */
  --bg:           #FAFAF6;  /* 页面底色，几乎是纸 */
  --bg-soft:      #F2F1EB;  /* 内嵌区块、stat grid 背景 */
  --card:         #FFFFFF;  /* 卡片、首推强调 */

  /* ── Ink ──────────────────────────────────────────────────────────── */
  --ink:          #0E0E0C;  /* 正文主色，几乎是黑 */
  --ink-2:        #2C2C28;  /* 次级正文、长描述 */
  --muted:        #55584F;  /* 元信息、hint */
  --subtle:       #7D8076;  /* 极弱辅助 */
  --on-accent:    #FFFFFF;  /* 在绿色按钮 / TOP 标签上的字 */

  /* ── Lines ────────────────────────────────────────────────────────── */
  --hair:         rgba(15, 15, 10, 0.10);   /* 主分割线 */
  --hair-strong:  rgba(15, 15, 10, 0.22);   /* 首推卡顶部线 */

  /* ── Accent · 单一品牌色 ──────────────────────────────────────────── */
  --accent:       #2C5E3F;  /* 苔藓绿。主按钮、TOP 标记、进度条 */
  --accent-ink:   #143A24;  /* 在 accent-soft 上的字 */
  --accent-soft:  #E5EFE7;  /* 当前选中态背景 */

  /* ── Signal · 慎用 ────────────────────────────────────────────────── */
  --warn:         #A85A1A;  /* 风险提醒、降级 */
  --warn-soft:    #F5E8D6;
  --bad:          #B5410E;  /* 硬冲突、错误 */
  --bad-soft:     #FBE8DE;
  --ok:           #2C5E3F;  /* 同 accent，"在线/ok" 状态用 */

  /* ── Typography ───────────────────────────────────────────────────── */
  --font-sans:    "PingFang SC", "Noto Sans SC", -apple-system, system-ui, sans-serif;
  --font-serif:   "PingFang SC", "Noto Sans SC", -apple-system, system-ui, sans-serif;
  --font-mono:    "IBM Plex Mono", "SF Mono", ui-monospace, Menlo, monospace;

  /* Type scale，单位 rpx（750rpx 屏宽）            ≈ px 在 375 屏 */
  --t-hero:        56rpx;   /* 28px · 思源宋, 页面 hero */
  --t-h1:          48rpx;   /* 24px · 思源宋, 段头 */
  --t-h2:          38rpx;   /* 19px · 思源宋, 卡片店名 */
  --t-body-l:      30rpx;   /* 15px · 苹方, 主要正文 */
  --t-body:        27rpx;   /* 13.5px · 苹方, 段落 */
  --t-cap:         24rpx;   /* 12px · 苹方/mono, 元信息 */
  --t-micro:       22rpx;   /* 11px · mono, 小标签 */
  --t-nano:        20rpx;   /* 10px · mono, 编号 / 全大写标签 */
  --t-stat:        34rpx;   /* 17px · mono, 数字统计 */
  --t-bignum:      96rpx;   /* 48px · mono, 天气主温度等 */

  /* ── Spacing ──────────────────────────────────────────────────────── */
  --s-1:           8rpx;
  --s-2:          12rpx;
  --s-3:          16rpx;
  --s-4:          24rpx;
  --s-5:          36rpx;
  --s-6:          48rpx;
  --s-7:          72rpx;

  /* ── Page rhythm ──────────────────────────────────────────────────── */
  --page-x:       36rpx;     /* 页面左右内边距 */
  --bar-h:        72rpx;     /* 顶部状态条高度 */
  --hit:          88rpx;     /* 最小可点高度（≥ 44px） */

  /* ── Radius · 整体偏直角 ─────────────────────────────────────────── */
  --r-0:           0;        /* 默认：直角 */
  --r-1:           4rpx;     /* chip / tag */
  --r-2:           8rpx;     /* 大按钮 */
  --r-pill:        9999rpx;  /* 极少用，仅在 wechat capsule mock */

  /* ── Motion ───────────────────────────────────────────────────────── */
  --ease:          cubic-bezier(0.2, 0.7, 0.3, 1);
  --dur-fast:      120ms;
  --dur:           220ms;

  /* ── Defaults ─────────────────────────────────────────────────────── */
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: var(--t-body-l);
  line-height: 1.5;
}

/* ════════════════════════════════════════════════════════════════════════
   原子工具类
   ════════════════════════════════════════════════════════════════════════ */

/* — 页面壳 — */
.el-page {
  min-height: 100vh;
  padding: 100rpx 0 60rpx;     /* 顶部留给 bar */
  background: var(--bg);
}

/* — 顶部状态条 (替代原 custom-food-header / page-bar) — */
.el-bar {
  position: sticky; top: 0; z-index: 10;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx var(--page-x);
  font-family: var(--font-mono);
  font-size: var(--t-micro);
  color: var(--muted);
  letter-spacing: 1rpx;
  text-transform: uppercase;
  background: var(--bg);
  border-bottom: 1rpx solid var(--hair);
}
.el-bar .left { color: var(--ink); }
.el-bar .right { display: flex; align-items: center; gap: 10rpx; }

/* — 段头 · 编号 + 大写小标题 + 右侧附注 (替代原 section-head) — */
.el-section {
  padding: 0 var(--page-x) var(--s-5);
}
.el-section__head {
  display: flex; align-items: baseline; gap: var(--s-1);
  margin-bottom: var(--s-3);
}
.el-section__no {
  font-family: var(--font-mono); font-size: var(--t-micro);
  color: var(--muted); letter-spacing: 1rpx;
}
.el-section__title {
  font-size: var(--t-body); font-weight: 600; letter-spacing: 1rpx;
  text-transform: uppercase; color: var(--ink-2);
}
.el-section__rule { flex: 1; height: 1rpx; background: var(--hair); margin-left: 8rpx; }
.el-section__sub  { font-family: var(--font-mono); font-size: var(--t-micro); color: var(--muted); }

/* — 大标题 (页面 hero) — */
.el-hero {
  font-family: var(--font-serif);
  font-size: var(--t-hero);
  font-weight: 650;
  letter-spacing: 0;
  line-height: 1.2;
  color: var(--ink);
}
.el-hero--md { font-size: var(--t-h1); }

/* — 正文段落 — */
.el-text       { font-size: var(--t-body); color: var(--ink-2); line-height: 1.6; }
.el-text--muted{ color: var(--muted); }
.el-text--lg   { font-size: var(--t-body-l); }

/* — Chip / Tag — */
.el-chip {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--hair);
  border-radius: var(--r-1);
  font-size: var(--t-cap);
  color: var(--ink-2);
}
.el-chip--mono { font-family: var(--font-mono); letter-spacing: 1rpx; }
.el-chip--accent {
  border-color: transparent; background: var(--accent-soft); color: var(--accent-ink);
}
.el-chip--solid {
  border-color: transparent; background: var(--ink); color: #fff; font-weight: 600;
}

/* — 按钮 — */
.el-btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: var(--hit);
  padding: 0 var(--s-4);
  border-radius: var(--r-2);
  border: 1rpx solid var(--ink);
  background: var(--card); color: var(--ink);
  font-family: var(--font-sans); font-size: var(--t-body-l); font-weight: 600;
  letter-spacing: 1rpx;
}
.el-btn--primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
.el-btn--ghost   { background: transparent; border-color: var(--hair); color: var(--ink); }
.el-btn--block   { width: 100%; }

/* — Toggle (开关) — */
.el-toggle {
  position: relative; display: inline-block;
  width: 72rpx; height: 40rpx; border-radius: 20rpx;
  background: #D6D4CC; transition: background var(--dur) var(--ease);
}
.el-toggle--on { background: var(--accent); }
.el-toggle::after {
  content: ""; position: absolute; top: 4rpx; left: 4rpx;
  width: 32rpx; height: 32rpx; border-radius: 16rpx;
  background: #fff; box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
  transition: left var(--dur) var(--ease);
}
.el-toggle--on::after { left: 36rpx; }

/* — Dot (在线 / 离线) — */
.el-dot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ok); }
.el-dot--warn { background: var(--warn); }
.el-dot--bad  { background: var(--bad); }

/* — Stat 四格数据条 — */
.el-stat-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  padding: var(--s-3) 0;
  border-top: 1rpx solid var(--hair);
  border-bottom: 1rpx solid var(--hair);
}
.el-stat__v { font-family: var(--font-mono); font-size: var(--t-stat); font-weight: 600; color: var(--ink); letter-spacing: 0; }
.el-stat__l { font-family: var(--font-mono); font-size: var(--t-nano); color: var(--muted); margin-top: 4rpx; letter-spacing: 1rpx; }

/* — Note · 风险/提醒 callout — */
.el-note {
  padding-left: 20rpx;
  border-left: 4rpx solid var(--warn);
  font-size: var(--t-cap);
  line-height: 1.55;
  color: var(--muted);
}
.el-note__tag {
  display: inline-block; font-family: var(--font-mono);
  font-size: var(--t-nano); color: var(--warn); font-weight: 600;
  letter-spacing: 1rpx; margin-right: 8rpx;
}
.el-note--bad { border-left-color: var(--bad); }
.el-note--bad .el-note__tag { color: var(--bad); }

/* — Settings 行 — */
.el-row {
  display: flex; align-items: center; gap: var(--s-3);
  padding: var(--s-4) 0;
  border-bottom: 1rpx solid var(--hair);
  min-height: var(--hit);
  box-sizing: border-box;
}
.el-row:last-child { border-bottom: 0; }
.el-row__body  { flex: 1; min-width: 0; }
.el-row__label { font-size: var(--t-body-l); font-weight: 500; color: var(--ink); }
.el-row__hint  { font-size: var(--t-cap); color: var(--muted); margin-top: 6rpx; line-height: 1.5; }
.el-row__value { font-family: var(--font-mono); font-size: var(--t-body); color: var(--ink-2); }

/* — 进度段 (替代原 progress-track 渐变) — */
.el-segs { display: flex; gap: 6rpx; }
.el-segs__seg { flex: 1; height: 6rpx; background: var(--hair); }
.el-segs__seg--on { background: var(--accent); }
.el-segs__seg--ink { background: var(--ink); }   /* 黑色版本，用在问答进度 */

/* — Timeline 站点 — */
.el-stop { display: flex; gap: 28rpx; padding: 8rpx 0; position: relative; }
.el-stop__time { font-family: var(--font-mono); font-size: var(--t-cap); color: var(--muted); width: 84rpx; flex-shrink: 0; }
.el-stop__dot  { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--muted); margin-top: 14rpx; flex-shrink: 0; }
.el-stop__dot--first { background: var(--accent); }
.el-stop__text { flex: 1; font-size: var(--t-body); color: var(--ink-2); padding-top: 4rpx; }
