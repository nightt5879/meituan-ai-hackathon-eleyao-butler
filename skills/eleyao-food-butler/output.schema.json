{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EleyaoFoodButlerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendations", "finalChoice", "normalAiMessage"],
  "properties": {
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "category", "budgetText", "distanceText", "matchedTagsText", "reason", "riskTip"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "budgetText": { "type": "string" },
          "distanceText": { "type": "string" },
          "matchedTagsText": { "type": "string" },
          "reason": { "type": "string" },
          "riskTip": { "type": "string" }
        }
      }
    },
    "finalChoice": { "type": "string" },
    "normalAiMessage": { "type": "string" }
  }
}
