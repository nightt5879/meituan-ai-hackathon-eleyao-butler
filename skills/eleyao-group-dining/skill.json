{
  "id": "eleyao-group-dining",
  "name": "多人约饭",
  "description": "汇总多人偏好、识别硬冲突，并在自建餐厅候选中输出公平、可执行的群体推荐。",
  "version": "2026.06.08",
  "entry": "SKILL.md",
  "prompt": "prompt.md",
  "inputSchema": "input.schema.json",
  "outputSchema": "output.schema.json",
  "examples": {
    "request": "examples/request.json",
    "response": "examples/response.json"
  },
  "backend": {
    "api": "POST /api/group-tasks/:taskId/recommend",
    "adapter": "frontend/lib/server/openclawRecommendation.ts",
    "taskStore": "frontend/lib/server/taskStore.ts",
    "conflictRules": "shared group-dining rule helpers",
    "miniProgramAdapter": "mini-program/wechat-miniprogram/services/groupDiningAdapter.js"
  },
  "safety": {
    "requiresInviteToken": true,
    "bindsParticipantByClientId": true,
    "forbidsSilentHardConstraintOverride": true,
    "usesSelfBuiltDataset": true,
    "fallbackWhenUnavailable": true
  }
}
